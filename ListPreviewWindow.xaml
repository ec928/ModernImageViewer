<Window
    x:Class="ModernImageViewer.ListPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Preview">

    <Grid x:Name="Root" Background="#FF1C1C1C" RequestedTheme="Dark"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased"
          PointerCanceled="Root_PointerReleased">
        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
        <FontIcon x:Name="Placeholder" Glyph="&#xE91B;" FontSize="32" Foreground="#66FFFFFF"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border VerticalAlignment="Bottom" Background="#C0000000" Padding="10,6" IsHitTestVisible="False">
            <TextBlock x:Name="Facts" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
