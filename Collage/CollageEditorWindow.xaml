<Window
    x:Class="ModernImageViewer.Collage.CollageEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernImageViewer.Collage"
    xmlns:collage="using:ModernImageViewer.Collage"
    Title="Collage Editor">

    <Grid x:Name="RootGrid">

        <collage:CollageCanvas x:Name="CollageCanvasControl" />

        <SplitView x:Name="SidebarView"
            PanePlacement="Left"
            DisplayMode="Overlay"
            OpenPaneLength="380"
            IsPaneOpen="False">

            <SplitView.Pane>
                <Grid x:Name="SidebarPane"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                      PointerExited="Sidebar_PointerExited">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Padding="16,48,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Icon Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,16" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Click="LoadProject_Click" HorizontalAlignment="Stretch" Padding="8,6" CornerRadius="4" ToolTipService.ToolTip="Open Project">
                                    <SymbolIcon Symbol="OpenFile"/>
                                </Button>
                                <Button Grid.Column="1" Click="SaveProject_Click" HorizontalAlignment="Stretch" Padding="8,6" CornerRadius="4" ToolTipService.ToolTip="Save Project">
                                    <SymbolIcon Symbol="Save"/>
                                </Button>
                                <Button Grid.Column="2" Click="SaveCollageImage_Click" HorizontalAlignment="Stretch" Padding="8,6" CornerRadius="4" ToolTipService.ToolTip="Export Collage">
                                    <SymbolIcon Symbol="Pictures"/>
                                </Button>
                                <Button Grid.Column="3" Click="CanvasSize_Click" HorizontalAlignment="Stretch" Padding="8,6" CornerRadius="4" ToolTipService.ToolTip="Canvas Size">
                                    <SymbolIcon Symbol="View"/>
                                </Button>
                                <Button Grid.Column="4" Click="ResetWindow_Click" HorizontalAlignment="Stretch" Padding="8,6" CornerRadius="4" ToolTipService.ToolTip="Reset View">
                                    <SymbolIcon Symbol="Refresh"/>
                                </Button>
                            </Grid>

                            <!-- Toggles -->
                            <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,20">
                                <ToggleSwitch x:Name="SnappingToggle" 
                                              Header="Snapping" 
                                              IsOn="True" 
                                              Toggled="SnappingToggle_Changed" />
                                <ToggleSwitch x:Name="GridToggle" 
                                              Header="Grid Overlay" 
                                              IsOn="False" 
                                              Toggled="GridToggle_Changed" />
                            </StackPanel>

                            <!-- Layout Section -->
                            <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Layout" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" 
                                            Click="UndoLayout_Click" 
                                            Padding="6,4" 
                                            ToolTipService.ToolTip="Undo Last Layout">
                                        <SymbolIcon Symbol="Undo" />
                                    </Button>
                                </Grid>

                                <!-- Static Visual Layout Grid -->
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0 -->
                                    <Button Grid.Row="0" Grid.Column="0" Content="Freeform" Tag="Freeform" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="Grid" Tag="Grid" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="Rows" Tag="Rows" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>

                                    <!-- Row 1 -->
                                    <Button Grid.Row="1" Grid.Column="0" Content="Columns" Tag="Columns" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="Masonry" Tag="Masonry" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="Tiled" Tag="Tiled" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>

                                    <!-- Row 2 -->
                                    <Button Grid.Row="2" Grid.Column="0" Content="Hero" Tag="Hero" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>
                                    <Button Grid.Row="2" Grid.Column="1" Content="Brick" Tag="Brick" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="Organic" Tag="Organic" Click="LayoutButton_Click" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="6" FontSize="12" FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>

                            <!-- Spacing -->
                            <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Spacing (Gap)" FontWeight="SemiBold"/>
                                    <!-- Replaced imperative code with declarative x:Bind -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{x:Bind FormatValue(GapSlider.Value), Mode=OneWay}" 
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="GapSlider" 
                                        Minimum="0" 
                                        Maximum="60" 
                                        Value="0" 
                                        StepFrequency="1" 
                                        ValueChanged="GapSlider_ValueChanged" />
                            </StackPanel>

                            <!-- Appearance -->
                            <StackPanel Grid.Row="4" Spacing="12">
                                <TextBlock Text="Appearance" FontWeight="SemiBold"/>

                                <!-- Border Thickness -->
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Border Thickness"/>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{x:Bind FormatValue(BorderSlider.Value), Mode=OneWay}" 
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="BorderSlider" 
                                            Minimum="0" 
                                            Maximum="40" 
                                            Value="0" 
                                            StepFrequency="1" 
                                            ValueChanged="AppearanceSlider_ValueChanged" />
                                </StackPanel>

                                <!-- Corner Radius -->
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Corner Radius"/>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{x:Bind FormatValue(RadiusSlider.Value), Mode=OneWay}" 
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="RadiusSlider" 
                                            Minimum="0" 
                                            Maximum="100" 
                                            Value="0" 
                                            StepFrequency="1" 
                                            ValueChanged="AppearanceSlider_ValueChanged" />
                                </StackPanel>

                                <!-- Shadow Intensity -->
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Shadow Intensity"/>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{x:Bind FormatValue(ShadowSlider.Value), Mode=OneWay}" 
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="ShadowSlider" 
                                            Minimum="0" 
                                            Maximum="50" 
                                            Value="0" 
                                            StepFrequency="1" 
                                            ValueChanged="AppearanceSlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid/>
            </SplitView.Content>
        </SplitView>

        <Grid x:Name="HoverTriggerZone" 
              Width="15" 
              HorizontalAlignment="Left" 
              Background="#01000000" 
              PointerEntered="HoverZone_PointerEntered" 
              Canvas.ZIndex="100" />
    </Grid>
</Window>