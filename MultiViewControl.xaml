<UserControl
    x:Class="ModernImageViewer.MultiViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernImageViewer"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    FocusVisualPrimaryThickness="0"
    FocusVisualSecondaryThickness="0">

    <UserControl.Resources>
        <!-- Premium Dark MenuFlyoutPresenter style for immersive HUD flyouts and context menus -->
        <Style x:Key="MultiViewMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="RequestedTheme" Value="Dark" />
            <Setter Property="Background" Value="#F2202020" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Caption and playbar buttons are pointer chrome. A tab stop here draws a white focus box on the first photo when the grid opens. -->
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
        <!-- Grid-layout flyout. Theme brushes so the card follows light and dark. -->
        <Style x:Key="LayoutStepperWellStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LayoutStepperDividerStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="LayoutStepperButtonStyle" TargetType="primitives:RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:RepeatButton">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LayoutEvenButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="LayoutTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}"/>
        <Style x:Key="LayoutSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LayoutChoiceHostStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- The choice pair sits in its own inset so the selected half is a closed box, the way the standalone switch was. -->
        <Style x:Key="LayoutChoiceTrackStyle" TargetType="Border">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- LayerFillColorDefault is a 30% wash and reads as the track once minus and plus share the bar. A solid control fill stays visible in light and dark. -->
        <Style x:Key="LayoutChoiceSelectedStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="LayoutChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="LayoutChoiceTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="LayoutChoiceTextSelectedStyle" TargetType="TextBlock" BasedOn="{StaticResource LayoutChoiceTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="LayoutChoiceIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="LayoutChoiceIconSelectedStyle" TargetType="FontIcon" BasedOn="{StaticResource LayoutChoiceIconStyle}">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="LayoutLineLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="LayoutDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="LayoutStripStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="LayoutCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="LayoutCountChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="LayoutCountChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="LayoutColumnLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="#FF080808" RequestedTheme="Dark" PointerMoved="RootGrid_PointerMoved"
          IsTabStop="True" UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0">
        <!-- Main Tiled Layout Container (Zero wasted space: edge to edge) -->
        <Grid x:Name="CellsGrid" Margin="0" Canvas.ZIndex="10">
            <!-- Dynamic Columns and Rows generated in C# -->
        </Grid>

        <!-- Bottom gradient scrim to guarantee HUD contrast over any image -->
        <Border x:Name="HudScrim"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Height="140"
                IsHitTestVisible="False"
                Canvas.ZIndex="70"
                Opacity="1.0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#44000000" Offset="0.5"/>
                    <GradientStop Color="#99000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Unified Bottom Playbar / HUD (Single Continuous Glass Capsule Deck) -->
        <Grid x:Name="UnifiedHud" 
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Center" 
              Margin="0,0,0,28" 
              Canvas.ZIndex="100"
              Opacity="1.0"
              PointerEntered="Hud_PointerEntered" 
              PointerExited="Hud_PointerExited">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HudTranslate" Y="0" />
            </Grid.RenderTransform>

            <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" 
                    BorderThickness="1" 
                    CornerRadius="22" 
                    Padding="6,4"
                    Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Group 1: Session Navigation -->
                    <Button Click="CloseButton_Click" 
                            Style="{StaticResource QuietButtonStyle}" 
                            Padding="8,5" 
                            CornerRadius="12" 
                            ToolTipService.ToolTip="Back to Grid (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="Grid" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Click="ChangePhotosButton_Click"
                            Style="{StaticResource QuietButtonStyle}"
                            Padding="8,5"
                            CornerRadius="12"
                            ToolTipService.ToolTip="Pick different photos. The layout stays.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B9;" FontSize="14" />
                            <TextBlock Text="Photos" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="ShownBadge"
                            Visibility="Collapsed"
                            Background="Transparent"
                            Padding="4,0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Multi-view shows up to 16 photos. The rest of the selection is not shown.">
                        <TextBlock x:Name="ShownText"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <!-- Subtle Section Divider 1 -->
                    <Rectangle Width="1" Height="18" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" Opacity="0.5"/>

                    <!-- Group 2: Layout & Composition -->
                    <Button x:Name="CountsButton"
                            Style="{StaticResource QuietButtonStyle}"
                            Padding="8,5"
                            CornerRadius="12"
                            ToolTipService.ToolTip="Edit the lines. Choose rows or columns, or press R. Plus and minus change how many.">
                        <Button.Flyout>
                            <Flyout Opening="CountsFlyout_Opening" Opened="CountsFlyout_Opened" Closed="CountsFlyout_Closed" Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MaxWidth" Value="640" />
                                        <Setter Property="MaxHeight" Value="760" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="CornerRadius" Value="12" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Border x:Name="CountsCard"
                                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16,14">
                                    <Border.Shadow>
                                        <ThemeShadow/>
                                    </Border.Shadow>
                                    <StackPanel x:Name="CountsPanel" Spacing="0" MinWidth="320" />
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xECA5;" FontSize="14" />
                            <TextBlock x:Name="CountsText" Text="2 Rows" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HeroButton"
                            Click="HeroButton_Click"
                            Style="{StaticResource QuietButtonStyle}"
                            Padding="8,5"
                            CornerRadius="12"
                            ToolTipService.ToolTip="Hero (H). Click for a large photo.">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="HeroIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xEE4E;" FontSize="14" />
                            <TextBlock x:Name="HeroText" Text="Hero" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RotateHeroButton"
                            Click="RotateHero_Click"
                            Style="{StaticResource QuietButtonStyle}"
                            Padding="8,5"
                            CornerRadius="12"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Next position">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7AD;" FontSize="14" />
                    </Button>

                    <!-- Subtle Section Divider 2 -->
                    <Rectangle Width="1" Height="18" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" Opacity="0.5"/>

                    <!-- Group 3: View & Output -->
                    <Button x:Name="FillFitButton" 
                            Click="FillFitButton_Click" 
                            Style="{StaticResource QuietButtonStyle}" 
                            Padding="8,5" 
                            CornerRadius="12" 
                            ToolTipService.ToolTip="Toggle Fill / Fit (F)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="FillFitIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="14" />
                            <TextBlock x:Name="FillFitText" Text="Fill" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button Click="ResetZoom_Click" 
                            Style="{StaticResource QuietButtonStyle}" 
                            Padding="8,5" 
                            CornerRadius="12" 
                            ToolTipService.ToolTip="Reset Pan &amp; Zoom (Middle-Click)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71F;" FontSize="14" />
                            <TextBlock Text="Reset" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="AspectButton"
                            Style="{StaticResource QuietButtonStyle}"
                            Padding="8,5"
                            CornerRadius="12"
                            ToolTipService.ToolTip="Canvas shape. Drag the window for a custom shape.">
                        <Button.Flyout>
                            <MenuFlyout x:Name="AspectMenuFlyout" 
                                        MenuFlyoutPresenterStyle="{StaticResource MultiViewMenuFlyoutPresenterStyle}"
                                        Opening="AspectFlyout_Opening" Opened="HudMenu_Opened" Closed="HudMenu_Closed"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="AspectText" Text="16:9" VerticalAlignment="Center" FontSize="13" />
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveButton"
                            Style="{StaticResource QuietButtonStyle}"
                            Padding="8,5"
                            CornerRadius="12"
                            ToolTipService.ToolTip="Save image or Save/Load layout (Ctrl+S)">
                        <Button.Flyout>
                            <MenuFlyout x:Name="SaveMenuFlyout" 
                                        MenuFlyoutPresenterStyle="{StaticResource MultiViewMenuFlyoutPresenterStyle}"
                                        Opening="SaveFlyout_Opening" Opened="HudMenu_Opened" Closed="HudMenu_Closed"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock x:Name="SaveText" Text="Save/Load" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Solo View Container (shown when user double-clicks or clicks Solo on a photo) -->
        <Grid x:Name="SoloContainer" Visibility="Collapsed" Canvas.ZIndex="150" Background="#FF080808">
            <Grid x:Name="SoloImageContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#01000000">
                <Image x:Name="SoloImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="SoloTransform" ScaleX="1" ScaleY="1" TranslateX="0" TranslateY="0"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Solo Top-Left Info Overlay (auto-hides with HUD, identical to single viewer HUD) -->
            <Border x:Name="SoloInfoOverlay" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,60,0,0"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Translation="0,0,24" IsHitTestVisible="False">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="SoloTitleText" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="350" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SoloSecondaryText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock x:Name="SoloZoomText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="&#x2022;" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.5"/>
                        <TextBlock x:Name="SoloFidelityText" Text="HF" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Solo Bottom Playbar (auto-hides with HUD) -->
            <Border x:Name="SoloBottomBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,32"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" CornerRadius="22" Padding="12,6" Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="ExitSolo_Click" Style="{StaticResource QuietButtonStyle}" Padding="8,5" CornerRadius="12" ToolTipService.ToolTip="Back to Multi-View (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock Text="All Photos" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,4" Opacity="0.4"/>
                    <Button Click="PrevSolo_Click" Style="{StaticResource QuietButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Previous (Left Arrow)">
                        <SymbolIcon Symbol="Previous" />
                    </Button>
                    <TextBlock x:Name="SoloCounterText" Text="1 of 4" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="4,0" />
                    <Button Click="NextSolo_Click" Style="{StaticResource QuietButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Next (Right Arrow)">
                        <SymbolIcon Symbol="Next" />
                    </Button>
                    <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,4" Opacity="0.4"/>
                    <Button Click="ResetSoloZoom_Click" Style="{StaticResource QuietButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Fit to Screen (Middle-Click)">
                        <SymbolIcon Symbol="ZoomOut" />
                    </Button>
                </StackPanel>
            </Border>
            <!-- Solo top-right: back to the grid. Close stays on the grid playbar. -->
            <Grid x:Name="SoloTopRightControls" HorizontalAlignment="Right" VerticalAlignment="Top" Canvas.ZIndex="60"
                  PointerEntered="Hud_PointerEntered" PointerExited="Hud_PointerExited">
                <Button Click="ExitSolo_Click" Width="46" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="0" IsTabStop="False" UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0" ToolTipService.ToolTip="Restore to Multi-View (Esc)">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#10FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C8FFFFFF"/>
                    </Button.Resources>
                    <FontIcon Glyph="&#xE923;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#F0FFFFFF"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
