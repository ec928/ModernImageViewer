<UserControl
    x:Class="ModernImageViewer.MultiViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernImageViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    FocusVisualPrimaryThickness="0"
    FocusVisualSecondaryThickness="0">

    <UserControl.Resources>
        <!-- Caption and playbar buttons are pointer chrome. A tab stop here draws a white focus box on the first photo when the grid opens. -->
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="#FF080808" RequestedTheme="Dark" PointerMoved="RootGrid_PointerMoved"
          IsTabStop="True" UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0">
        <!-- Main Tiled Layout Container (Zero wasted space: edge to edge) -->
        <Grid x:Name="CellsGrid" Margin="0" Canvas.ZIndex="10">
            <!-- Dynamic Columns and Rows generated in C# -->
        </Grid>

        <!-- Bottom gradient scrim to guarantee HUD contrast over any image -->
        <Border x:Name="HudScrim"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Height="140"
                IsHitTestVisible="False"
                Canvas.ZIndex="70"
                Opacity="1.0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#44000000" Offset="0.5"/>
                    <GradientStop Color="#99000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Unified Bottom Playbar / HUD (Auto-Hiding Floating Islands) -->
        <Grid x:Name="UnifiedHud" 
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Center" 
              Margin="0,0,0,28" 
              Canvas.ZIndex="100"
              Opacity="1.0"
              PointerEntered="Hud_PointerEntered" 
              PointerExited="Hud_PointerExited">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HudTranslate" Y="0" />
            </Grid.RenderTransform>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Island 1: Session Navigation -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="24" 
                        Padding="10,6"
                        Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Click="CloseButton_Click" 
                                Style="{StaticResource QuietButtonStyle}" 
                                Padding="8,5" 
                                CornerRadius="14" 
                                ToolTipService.ToolTip="Back to Grid (Esc)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Back" />
                                <TextBlock Text="Grid" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="ShownBadge"
                                Visibility="Collapsed"
                                Background="#1FFFFFFF"
                                CornerRadius="10"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Multi-view shows up to 16 photos. The rest of the selection is not shown.">
                            <TextBlock x:Name="ShownText"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Opacity="0.85" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Island 2: Layout & Composition -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="24" 
                        Padding="10,6"
                        Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Rows or columns: fewer, count/flip, more -->
                        <StackPanel x:Name="LinesGroup" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <Button x:Name="LinesLessButton"
                                    Click="LinesLess_Click"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Padding="6,5"
                                    CornerRadius="14"
                                    ToolTipService.ToolTip="Fewer (-)">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE738;" FontSize="12" />
                            </Button>
                            <Button x:Name="LinesDirectionButton"
                                    Click="RowsColumns_Click"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Padding="8,5"
                                    CornerRadius="14"
                                    ToolTipService.ToolTip="Click to toggle between rows and columns">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8AB;" FontSize="11" Opacity="0.8" />
                                    <TextBlock x:Name="LinesText" Text="2 rows" VerticalAlignment="Center" FontSize="13" MinWidth="48" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LinesMoreButton"
                                    Click="LinesMore_Click"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Padding="6,5"
                                    CornerRadius="14"
                                    ToolTipService.ToolTip="More (+)">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12" />
                            </Button>
                        </StackPanel>

                        <Button x:Name="CountsButton"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="8,5"
                                CornerRadius="14"
                                ToolTipService.ToolTip="Photos per line (Click to customize)">
                            <Button.Flyout>
                                <Flyout Opening="CountsFlyout_Opening" Opened="HudMenu_Opened" Closed="HudMenu_Closed" Placement="Top">
                                    <StackPanel x:Name="CountsPanel" Spacing="4" MinWidth="220" />
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xECA5;" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="CountsText" Text="3 · 2" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,4" Opacity="0.4"/>

                        <Button x:Name="HeroButton"
                                Click="HeroButton_Click"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="8,5"
                                CornerRadius="14"
                                ToolTipService.ToolTip="Hero (H). Click for a large photo.">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon x:Name="HeroIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE734;" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="HeroText" Text="Hero" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="RotateHeroButton"
                                Click="RotateHero_Click"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="8,5"
                                CornerRadius="14"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Next position">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7AD;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Island 3: View & Output -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="24" 
                        Padding="10,6"
                        Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Fill / Fit Toggle Button -->
                        <Button x:Name="FillFitButton" 
                                Click="FillFitButton_Click" 
                                Style="{StaticResource QuietButtonStyle}" 
                                Padding="8,5" 
                                CornerRadius="14" 
                                ToolTipService.ToolTip="Toggle Fill / Fit (F)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="FillFitIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="14" />
                                <TextBlock x:Name="FillFitText" Text="Fill" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Reset Zooms Button -->
                        <Button Click="ResetZoom_Click" 
                                Style="{StaticResource QuietButtonStyle}" 
                                Padding="8,5" 
                                CornerRadius="14" 
                                ToolTipService.ToolTip="Reset Pan &amp; Zoom (Middle-Click)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <SymbolIcon Symbol="ZoomOut" />
                                <TextBlock Text="Reset" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,4" Opacity="0.4"/>

                        <!-- Canvas Shape -->
                        <Button x:Name="AspectButton"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="8,5"
                                CornerRadius="14"
                                ToolTipService.ToolTip="Canvas shape. Drag the window for a custom shape.">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AspectMenuFlyout" Opening="AspectFlyout_Opening" Opened="HudMenu_Opened" Closed="HudMenu_Closed" />
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="AspectText" Text="16:9" VerticalAlignment="Center" FontSize="13" />
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="9" Opacity="0.5" VerticalAlignment="Center" Margin="1,1,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Save JPEG -->
                        <Button x:Name="SaveButton"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="8,5"
                                CornerRadius="14"
                                ToolTipService.ToolTip="Save this grid as a JPEG">
                            <Button.Flyout>
                                <MenuFlyout x:Name="SaveMenuFlyout" Opening="SaveFlyout_Opening" Opened="HudMenu_Opened" Closed="HudMenu_Closed" />
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock x:Name="SaveText" Text="Save" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Solo View Container (shown when user double-clicks or clicks Solo on a photo) -->
        <Grid x:Name="SoloContainer" Visibility="Collapsed" Canvas.ZIndex="150" Background="#FF080808">
            <Grid x:Name="SoloImageContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#01000000">
                <Image x:Name="SoloImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="SoloTransform" ScaleX="1" ScaleY="1" TranslateX="0" TranslateY="0"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Solo Top-Left Info Overlay (auto-hides with HUD) -->
            <Border x:Name="SoloInfoOverlay" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,16,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Translation="0,0,24">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="SoloTitleText" Text="Photo 1 of 4" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="SoloSecondaryText" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Solo Bottom Playbar (auto-hides with HUD) -->
            <Border x:Name="SoloBottomBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,32"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="22" Padding="12,6" Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="ExitSolo_Click" Style="{StaticResource QuietButtonStyle}" Padding="8,5" CornerRadius="12" ToolTipService.ToolTip="Back to Multi-View (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock Text="All Photos" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,4" Opacity="0.4"/>
                    <Button Click="PrevSolo_Click" Style="{StaticResource QuietButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Previous (Left Arrow)">
                        <SymbolIcon Symbol="Previous" />
                    </Button>
                    <TextBlock x:Name="SoloCounterText" Text="1 of 4" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="4,0" />
                    <Button Click="NextSolo_Click" Style="{StaticResource QuietButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Next (Right Arrow)">
                        <SymbolIcon Symbol="Next" />
                    </Button>
                    <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,4" Opacity="0.4"/>
                    <Button Click="ResetSoloZoom_Click" Style="{StaticResource QuietButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Fit to Screen (Middle-Click)">
                        <SymbolIcon Symbol="ZoomOut" />
                    </Button>
                </StackPanel>
            </Border>
            <!-- Solo top-right: back to the grid. Close stays on the grid playbar. -->
            <Grid x:Name="SoloTopRightControls" HorizontalAlignment="Right" VerticalAlignment="Top" Canvas.ZIndex="60"
                  PointerEntered="Hud_PointerEntered" PointerExited="Hud_PointerExited">
                <Button Click="ExitSolo_Click" Width="46" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="0" IsTabStop="False" UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0" ToolTipService.ToolTip="Restore to Multi-View (Esc)">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#10FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C8FFFFFF"/>
                    </Button.Resources>
                    <FontIcon Glyph="&#xE923;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#F0FFFFFF"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
