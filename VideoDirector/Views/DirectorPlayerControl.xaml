<UserControl
    x:Class="ModernImageViewer.VideoDirector.Views.DirectorPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black"
    CornerRadius="8"
    Margin="12,0,12,0">

    <UserControl.Resources>
        <!-- PiP reshape handle: small white square with a dark outline, flush inside a box corner/edge. -->
        <Style x:Key="PipHandleStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stroke" Value="#99000000" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The A-B Roll Media Players -->
        <Grid>
            <Grid x:Name="GridB" x:FieldModifier="public" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="TransformB" x:FieldModifier="public" />
                </Grid.RenderTransform>
                <MediaPlayerElement x:Name="PlayerB" x:FieldModifier="public" AreTransportControlsEnabled="False" Stretch="Uniform" Opacity="0" />
            </Grid>
            <Grid x:Name="GridA" x:FieldModifier="public" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="TransformA" x:FieldModifier="public" />
                </Grid.RenderTransform>
                <MediaPlayerElement x:Name="PlayerA" x:FieldModifier="public" AreTransportControlsEnabled="False" Stretch="Uniform" Opacity="1" />
            </Grid>
        </Grid>

        <!-- Overlay Players (rendered on top of main A/B roll, below WYSIWYG and InputLayer).
             Each overlay grid IS the placement box (the PiP window): its size/position/clip are
             set in code (VideoPlaybackEngine.ApplyOverlayBox) from the clip's placement fields.
             The CompositeTransform lives on the MediaPlayerElement and frames the CONTENT
             (marks: zoom/pan/motion), clipped to the box. During edit the box fills the screen
             so content is framed full-size, identical to Track 1. -->
        <Grid x:Name="OverlayGrid1" x:FieldModifier="public"
              Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <MediaPlayerElement x:Name="OverlayPlayer1" x:FieldModifier="public"
                                AreTransportControlsEnabled="False" Stretch="UniformToFill"
                                RenderTransformOrigin="0.5,0.5">
                <MediaPlayerElement.RenderTransform>
                    <CompositeTransform x:Name="OverlayTransform1" x:FieldModifier="public" />
                </MediaPlayerElement.RenderTransform>
            </MediaPlayerElement>
            <!-- Still-image proxy for Arrange/scrub (§7A): a plain bitmap reshapes/moves/crops
                 cleanly where the live video surface goes blank/green. Video shows only at playback. -->
            <Image x:Name="OverlayImage1" x:FieldModifier="public" Stretch="UniformToFill" Visibility="Collapsed" />
            <!-- Reshape chrome (Arrange only): outline + 8 drag handles. Visual only — the
                 full-screen InputLayer does the hit-testing, so these never intercept input.
                 Handles sit flush inside the box edges so the box clip doesn't crop them. -->
            <Grid x:Name="OverlayHandles1" x:FieldModifier="public" IsHitTestVisible="False" Visibility="Collapsed">
                <Border BorderBrush="#CCFFFFFF" BorderThickness="1.5" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Left"   VerticalAlignment="Top" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Right"  VerticalAlignment="Top" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Left"   VerticalAlignment="Center" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Right"  VerticalAlignment="Center" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Left"   VerticalAlignment="Bottom" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Right"  VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
        <Grid x:Name="OverlayGrid2" x:FieldModifier="public"
              Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <MediaPlayerElement x:Name="OverlayPlayer2" x:FieldModifier="public"
                                AreTransportControlsEnabled="False" Stretch="UniformToFill"
                                RenderTransformOrigin="0.5,0.5">
                <MediaPlayerElement.RenderTransform>
                    <CompositeTransform x:Name="OverlayTransform2" x:FieldModifier="public" />
                </MediaPlayerElement.RenderTransform>
            </MediaPlayerElement>
            <Image x:Name="OverlayImage2" x:FieldModifier="public" Stretch="UniformToFill" Visibility="Collapsed" />
            <Grid x:Name="OverlayHandles2" x:FieldModifier="public" IsHitTestVisible="False" Visibility="Collapsed">
                <Border BorderBrush="#CCFFFFFF" BorderThickness="1.5" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Left"   VerticalAlignment="Top" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Right"  VerticalAlignment="Top" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Left"   VerticalAlignment="Center" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Right"  VerticalAlignment="Center" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Left"   VerticalAlignment="Bottom" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                <Rectangle Style="{StaticResource PipHandleStyle}" HorizontalAlignment="Right"  VerticalAlignment="Bottom" />
            </Grid>
        </Grid>

        <!-- WYSIWYG Overlay for Edit Mode -->
        <Canvas x:Name="WysiwygCanvas" x:FieldModifier="public" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle x:Name="WysiwygStartRect" x:FieldModifier="public" Stroke="Cyan" Fill="Transparent" StrokeThickness="2" StrokeDashArray="4,4" Visibility="Collapsed" />
            <Rectangle x:Name="WysiwygMidRect" x:FieldModifier="public" Stroke="DeepSkyBlue" Fill="Transparent" StrokeThickness="2" StrokeDashArray="4,4" Visibility="Collapsed" />
            <Rectangle x:Name="WysiwygEndRect" x:FieldModifier="public" Stroke="RoyalBlue" Fill="Transparent" StrokeThickness="2" StrokeDashArray="4,4" Visibility="Collapsed" />
            <Rectangle x:Name="WysiwygFullFrameRect" x:FieldModifier="public" Stroke="#80FFFFFF" StrokeThickness="1" Visibility="Collapsed" />
        </Canvas>

        <!-- Interactive Input Layer for Manual Targeting -->
        <Grid x:Name="InputLayer" Background="Transparent"
              PointerWheelChanged="InputLayer_PointerWheelChanged"
              PointerPressed="InputLayer_PointerPressed"
              PointerMoved="InputLayer_PointerMoved"
              PointerReleased="InputLayer_PointerReleased"
              PointerCanceled="InputLayer_PointerCanceled"
              DoubleTapped="InputLayer_DoubleTapped" />

        <!-- HUD Overlays -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Spacing="16" IsHitTestVisible="False">
            <!-- Telemetry Overlay -->
            <Grid x:Name="TelemetryOverlay" x:FieldModifier="public" Background="#80000000" CornerRadius="4" Padding="12" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="TELEMETRY" FontWeight="Bold" Foreground="Lime"/>
                    <TextBlock x:Name="TelemetryStoryTime" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryClipTime" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryOperationInfo" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryStartMarkInfo" x:FieldModifier="public" Foreground="Cyan" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryMidMarkInfo" x:FieldModifier="public" Foreground="DeepSkyBlue" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryEndMarkInfo" x:FieldModifier="public" Foreground="RoyalBlue" FontFamily="Consolas" />
                </StackPanel>
            </Grid>


        </StackPanel>
              
    </Grid>
</UserControl>
