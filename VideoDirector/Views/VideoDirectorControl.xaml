<UserControl
    x:Class="ModernImageViewer.VideoDirector.Views.VideoDirectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ModernImageViewer.VideoDirector.Views"
    xmlns:models="using:ModernImageViewer.VideoDirector.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DirectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <local:EmptyToVisConverter x:Key="EmptyToVisConverter" />
            <local:NullToVisConverter x:Key="NullToVisConverter" />
            <local:NullToBoolConverter x:Key="NullToBoolConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Black" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />    <!-- Canvas area (player + right panel + floating pill) -->
            <RowDefinition Height="Auto" /> <!-- Bottom track dock (collapses when hidden) -->
        </Grid.RowDefinitions>

        <!-- Background Layer: Full Bleed Immersive Player -->
        <local:DirectorPlayerControl x:Name="PlayerControl" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Foreground Layer: Floating Edit Badge -->
        <Border x:Name="EditModeBadge" Background="#D9E81123" CornerRadius="8" Padding="16,8" 
                Visibility="{x:Bind ViewModel.IsRecordingMotion, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Vertical" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Video" Foreground="White" />
                    <TextBlock x:Name="EditModeText" Text="Live Recording: Move Camera" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Zoom with scroll wheel. Pan by dragging. Set speed to &gt;0x to capture." Foreground="White" Opacity="0.8" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Foreground Layer: Right Side Panel (The Storyboard) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="380" 
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" 
                CornerRadius="8,0,0,8" Margin="0,48,0,0"
                Visibility="{x:Bind ViewModel.IsStoryboardVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CommandBar DefaultLabelPosition="Right" Background="Transparent" Padding="4">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton Icon="Save" Label="Save" Click="Save_Click" />
                        <AppBarButton Icon="OpenFile" Label="Load" Click="Load_Click" />
                        <AppBarButton Icon="Delete" Label="Clear" Click="Clear_Click" />
                    </CommandBar.PrimaryCommands>
                    <CommandBar.Content>
                        <TextBlock Text="Storyboard" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </CommandBar.Content>
                </CommandBar>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0"
                              ItemsSource="{x:Bind ViewModel.TimelineNodes}"
                              ItemTemplate="{StaticResource OperationTemplate}"
                              CanReorderItems="True"
                              CanDragItems="True"
                              AllowDrop="True"
                              SelectionMode="Single"
                              SelectedItem="{x:Bind ViewModel.SelectedTimelineNode, Mode=TwoWay}"
                              SelectionChanged="ListView_SelectionChanged"
                              RightTapped="ListView_RightTapped"
                              GotFocus="ListView_GotFocus"
                              Margin="12"
                              HorizontalAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="ContextFlyout">
                                    <Setter.Value>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Duplicate" Click="Duplicate_Click" />
                                            <MenuFlyoutItem Text="Remove" Click="Remove_Click" />
                                        </MenuFlyout>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                Visibility="{x:Bind ViewModel.TimelineNodes.Count, Converter={StaticResource EmptyToVisConverter}, Mode=OneWay, FallbackValue=Visible}">
                        <FontIcon Glyph="&#xE8B1;" FontSize="48" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                        <TextBlock Text="Drag and drop video files here" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="12,4" />

                    <Grid Grid.Row="2" AllowDrop="True" DragOver="OverlaySection_DragOver" Drop="OverlaySection_Drop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Overlays" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Click="AddOverlay_Click" Padding="6,3" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Add a picture-in-picture overlay clip">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.OverlayClips}"
                                  ItemTemplate="{StaticResource OverlayTemplate}"
                                  SelectionMode="Single"
                                  SelectedItem="{x:Bind ViewModel.SelectedOverlay, Mode=TwoWay}"
                                  RightTapped="OverlayListView_RightTapped"
                                  Margin="12,0,12,12"
                                  HorizontalAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="ContextFlyout">
                                        <Setter.Value>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Duplicate" Click="DuplicateOverlay_Click" />
                                                <MenuFlyoutItem Text="Remove" Click="RemoveOverlay_Click" />
                                            </MenuFlyout>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.OverlayClips.Count, Converter={StaticResource EmptyToVisConverter}, Mode=OneWay, FallbackValue=Visible}">
                            <TextBlock Text="Drag a clip here, or" TextAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                            <Button Content="+ Add Overlay" Click="AddOverlay_Click" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Contextual Inspector Panel: Track 1 clip -->
                <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ViewModel.SelectedTimelineNode, Mode=OneWay, Converter={StaticResource NullToVisConverter}}"
                        Padding="16" MaxHeight="350">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Zoom / Motion Cluster (Top) -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Zoom &amp; Motion Controls" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SetStartButton" Content="Start" Width="60" FontWeight="SemiBold" Click="SetStart_Click" ToolTipService.ToolTip="Set Start Keyframe" Foreground="Cyan" />
                                    <Button x:Name="SetMidButton" Content="Mid" Width="60" FontWeight="SemiBold" Click="SetMid_Click" ToolTipService.ToolTip="Set Mid Keyframe" Foreground="DeepSkyBlue" />
                                    <Button x:Name="SetEndButton" Content="End" Width="60" FontWeight="SemiBold" Click="SetEnd_Click" ToolTipService.ToolTip="Set End Keyframe" Foreground="RoyalBlue" />
                                    <ToggleButton x:Name="RecordButton" Click="RecordButton_Click" ToolTipService.ToolTip="Record Motion" Height="32" Padding="8,4" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <SymbolIcon x:Name="RecordIcon" Symbol="Video" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="Record" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Single Grid for all property fields -->
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Curve Profile -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Curve Profile" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding SelectedTimelineNode.CurveProfileIndex, Mode=TwoWay, FallbackValue=0}" HorizontalAlignment="Stretch">
                                    <x:String>Linear</x:String>
                                    <x:String>Bezier</x:String>
                                    <x:String>DirectorsArc</x:String>
                                </ComboBox>

                                <!-- Playback Speed -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Playback Speed" VerticalAlignment="Center" />
                                <NumberBox Grid.Row="1" Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedTimelineNode.PlaybackSpeed, Mode=TwoWay, FallbackValue=1.0}" 
                                           SmallChange="0.1" LargeChange="0.5" Minimum="0" SpinButtonPlacementMode="Inline" />
                                           
                                <!-- Clip Duration -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Clip Duration (s)" VerticalAlignment="Center" />
                                <NumberBox Grid.Row="2" Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedTimelineNode.OpDuration, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=1.0}" 
                                           SmallChange="0.5" LargeChange="1.0" Minimum="0" SpinButtonPlacementMode="Inline" />

                                <!-- Transition Style -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Transition Out Style" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding SelectedTimelineNode.TransitionStyleIndex, Mode=TwoWay, FallbackValue=0}" HorizontalAlignment="Stretch">
                                    <x:String>HardSnap</x:String>
                                    <x:String>Crossfade</x:String>
                                    <x:String>CinematicBridge</x:String>
                                    <x:String>DipToColor</x:String>
                                </ComboBox>

                                <!-- Transition Duration -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Transition Out Duration (s)" VerticalAlignment="Center" />
                                <NumberBox Grid.Row="4" Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedTimelineNode.TransitionDuration, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=0.0}" 
                                           SmallChange="0.1" LargeChange="0.5" Minimum="0" SpinButtonPlacementMode="Inline" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Contextual Inspector Panel: Overlay clip -->
                <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ViewModel.SelectedOverlay, Mode=OneWay, Converter={StaticResource NullToVisConverter}}"
                        Padding="16" MaxHeight="350">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding SelectedOverlay.FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Zoom &amp; Motion: scroll/drag to frame, then set Start and End. Same as Track 1." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Set Start" Width="90" FontWeight="SemiBold" Click="SetOverlayStart_Click" Foreground="Cyan" ToolTipService.ToolTip="Capture the current framing as the overlay's start" />
                                    <Button Content="Set End" Width="90" FontWeight="SemiBold" Click="SetOverlayEnd_Click" Foreground="RoyalBlue" ToolTipService.ToolTip="Capture the current framing as the overlay's end (leave same as Start for no motion)" />
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Box Position" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="OverlayBoxPositionCombo" SelectionChanged="OverlayBoxPosition_SelectionChanged" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Where the PiP box sits on screen">
                                    <x:String>Top Left</x:String>
                                    <x:String>Top Right</x:String>
                                    <x:String>Bottom Left</x:String>
                                    <x:String>Bottom Right</x:String>
                                    <x:String>Center</x:String>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Box Size" VerticalAlignment="Center" />
                                <NumberBox Grid.Row="1" Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedOverlay.PlacementScale, Mode=TwoWay, FallbackValue=0.3}"
                                           SmallChange="0.05" LargeChange="0.1" Minimum="0.05" Maximum="1.0" SpinButtonPlacementMode="Inline" ToolTipService.ToolTip="PiP box size as a fraction of the frame (0.3 = 30%)" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Start Time (s)" VerticalAlignment="Center" />
                                <NumberBox Grid.Row="2" Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedOverlay.StartTimeSeconds, Mode=TwoWay, FallbackValue=0.0}"
                                           SmallChange="0.5" LargeChange="1.0" Minimum="0" SpinButtonPlacementMode="Inline" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration (s)" VerticalAlignment="Center" />
                                <NumberBox Grid.Row="3" Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedOverlay.OpDuration, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=5.0}"
                                           SmallChange="0.5" LargeChange="1.0" Minimum="0.1" SpinButtonPlacementMode="Inline" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Opacity" VerticalAlignment="Center" />
                                <NumberBox Grid.Row="4" Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedOverlay.Opacity, Mode=TwoWay, FallbackValue=1.0}"
                                           SmallChange="0.1" LargeChange="0.25" Minimum="0" Maximum="1" SpinButtonPlacementMode="Inline" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Foreground Layer: Floating Pill Control Bar -->
        <Border x:Name="FloatingPill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32" Padding="12,8"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="16"
                Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                RequestedTheme="Dark">
            <StackPanel Spacing="4">
                <Grid Margin="0,0,0,4" Padding="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:TimelineRangeSlider Grid.Column="0" Grid.ColumnSpan="3"
                                               Maximum="{x:Bind ViewModel.CurrentOperationDurationSeconds, Mode=OneWay}"
                                               Position="{x:Bind ViewModel.CurrentOperationTimeSeconds, Mode=TwoWay}"
                                               TrimStart="{Binding SelectedTimelineNode.VideoStartTime, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}}"
                                               TrimEnd="{Binding SelectedTimelineNode.VideoEndTime, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}}"
                                               InteractionStarted="TimelineRangeSlider_InteractionStarted"
                                               InteractionCompleted="TimelineRangeSlider_InteractionCompleted" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Toggles Column -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton x:Name="ShuffleButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Toggle Shuffle">
                            <SymbolIcon Symbol="Shuffle" />
                        </ToggleButton>
                        <ToggleButton x:Name="LoopButton" IsChecked="{x:Bind ViewModel.IsLooping, Mode=TwoWay}" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Toggle Loop" Padding="0">
                            <FontIcon Glyph="&#xE8EE;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AutoPlayButton" IsChecked="{x:Bind ViewModel.IsAutoPlayEnabled, Mode=TwoWay}" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Toggle Auto-Play" Padding="0">
                            <FontIcon Glyph="&#xE173;" FontSize="14" />
                        </ToggleButton>
                        <Button x:Name="ResetClipButton" Click="ResetClip_Click" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Reset Clip Modifications" Padding="0" IsEnabled="{x:Bind ViewModel.SelectedTimelineNode.HasModifications, Mode=OneWay, FallbackValue=False}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="32" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="8,0" />

                    <!-- Transport Column -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="20" Click="Prev_Click" ToolTipService.ToolTip="Previous">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Width="48" Height="48" Background="Transparent" BorderThickness="0" CornerRadius="24" Click="PlayPause_Click" ToolTipService.ToolTip="Play/Pause">
                            <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                        </Button>
                        <Button x:Name="NextButton" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="20" Click="Next_Click" ToolTipService.ToolTip="Next">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                    </StackPanel>



                    <!-- Global Stack -->
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="GLOBAL" FontSize="9" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox SelectedItem="{x:Bind ViewModel.PlaybackSpeed, Mode=TwoWay}" 
                                      ItemsSource="{x:Bind ViewModel.AvailableSpeeds}"
                                      Width="60" Height="28" MinHeight="28" FontSize="11" Padding="8,0" VerticalAlignment="Center" ToolTipService.ToolTip="Global Speed" />
                            <ToggleButton x:Name="StoryboardButton" IsChecked="{x:Bind ViewModel.IsStoryboardVisible, Mode=TwoWay}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Toggle Storyboard">
                                <SymbolIcon Symbol="List" />
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Track Dock: horizontal arrangement lanes (one per track). -->
        <Border Grid.Row="1" x:Name="TrackDock"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Visibility="{x:Bind ViewModel.IsStoryboardVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                Padding="8,6">
            <StackPanel Spacing="4">
                <!-- Track 1 lane -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Track 1" VerticalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView Grid.Column="1" x:Name="Track1Lane"
                              ItemsSource="{x:Bind ViewModel.TimelineNodes}"
                              ItemTemplate="{StaticResource DockTileTemplate}"
                              SelectedItem="{x:Bind ViewModel.SelectedTimelineNode, Mode=TwoWay}"
                              SelectionMode="Single"
                              Height="74"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
