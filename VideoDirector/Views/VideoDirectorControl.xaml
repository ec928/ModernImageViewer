<UserControl
    x:Class="ModernImageViewer.VideoDirector.Views.VideoDirectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ModernImageViewer.VideoDirector.Views"
    xmlns:models="using:ModernImageViewer.VideoDirector.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DirectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:EmptyToVisConverter x:Key="EmptyToVisConverter" />
            <local:NullToVisConverter x:Key="NullToVisConverter" />
            <local:NullToBoolConverter x:Key="NullToBoolConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.KeyboardAccelerators>
        <!-- Escape leaves Edit mode; Space toggles play/pause; Delete removes the selected clip.
             Space/Delete are ignored while a text field has focus (see the handlers). -->
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        <KeyboardAccelerator Key="Space" Invoked="PlayPauseAccelerator_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid Background="Black" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />    <!-- Canvas area (player + right panel + floating pill) -->
            <RowDefinition Height="Auto" /> <!-- Bottom track dock (collapses when hidden) -->
        </Grid.RowDefinitions>

        <!-- Background Layer: Full Bleed Immersive Player -->
        <local:DirectorPlayerControl x:Name="PlayerControl" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- ===== Zone A: Global Command Zone (top-right) =====
             Project-scoped controls only — the mode badge (read-only state) + Save/Load/Clear.
             Deliberately separated from the selection-scoped Properties panel so the
             biggest-blast-radius actions never sit next to per-clip fields. Top margin clears the
             window caption/drag region. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,52,16,0">
            <!-- Mode badge: read-only. Accent-tinted in Edit. -->
            <Border VerticalAlignment="Center" CornerRadius="4" Padding="10,5"
                    Background="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToBadgeBrushConverter}}">
                <TextBlock Text="{x:Bind ViewModel.ModeLabel, Mode=OneWay}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <!-- Export: the payoff action — renders the composite to an MP4. Accented so it reads
                 as the primary project action. -->
            <Button Click="Export_Click" Height="34" Padding="12,0" CornerRadius="4" BorderThickness="0"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    ToolTipService.ToolTip="Export the composite to an MP4 video">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Video" Foreground="White" />
                    <TextBlock Text="Export" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Global actions: plain icon buttons (a CommandBar fights a small right-aligned
                 group). Save / Load / Clear — project scope only. -->
            <Border CornerRadius="4" Background="#99000000" VerticalAlignment="Center" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Click="Undo_Click" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                        <SymbolIcon Symbol="Undo" Foreground="White" />
                    </Button>
                    <Button Click="Redo_Click" IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                        <SymbolIcon Symbol="Redo" Foreground="White" />
                    </Button>
                    <AppBarSeparator />
                    <Button Click="Save_Click" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Save project">
                        <SymbolIcon Symbol="Save" Foreground="White" />
                    </Button>
                    <Button Click="Load_Click" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Load project">
                        <SymbolIcon Symbol="OpenFile" Foreground="White" />
                    </Button>
                    <Button Click="Clear_Click" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Clear project">
                        <SymbolIcon Symbol="Delete" Foreground="White" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Unmistakable EDIT indicator: an accent border around the canvas. The textual indicator
             and the way out (Done) now live in the inspector panel header, next to the edit
             controls, rather than as a separate floating pill. -->
        <Border Grid.Row="0" IsHitTestVisible="False" CornerRadius="8" Margin="12,0,12,0"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3"
                Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

        <!-- Foreground Layer: Floating Edit Badge -->
        <Border x:Name="EditModeBadge" Background="#D9E81123" CornerRadius="8" Padding="16,8" 
                Visibility="{x:Bind ViewModel.IsRecordingMotion, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Vertical" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Video" Foreground="White" />
                    <TextBlock x:Name="EditModeText" Text="Live Recording: Move Camera" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Zoom with scroll wheel. Pan by dragging. Set speed to &gt;0x to capture." Foreground="White" Opacity="0.8" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Foreground Layer: Right Side Panel (Properties). Top margin clears the Global Command
             Zone strip above it so Save/Load/Clear stay reachable while this panel is open. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="380"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                CornerRadius="8,0,0,8" Margin="0,96,0,0"
                Visibility="{x:Bind ViewModel.IsStoryboardVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Edit header + CommandBar -->
                    <RowDefinition Height="*" />    <!-- Inspector area -->
                </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <!-- Edit-mode header: the clip being edited + the way out, co-located with the edit
                     controls below. Shown only while editing. -->
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="14,8"
                        Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="EDITING" Foreground="White" FontSize="10" FontWeight="Bold" Opacity="0.85" />
                            <TextBlock Text="{Binding SelectedClip.FileName, Mode=OneWay}" Foreground="White"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="ExitToArrange_Click" VerticalAlignment="Center"
                                Background="#33FFFFFF" BorderThickness="0" CornerRadius="12" Padding="12,4"
                                ToolTipService.ToolTip="Done editing — back to Arrange (Esc, or double-click the image)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Accept" Foreground="White" />
                                <TextBlock Text="Done" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Selection-scoped panel header. Project actions (Save/Load/Clear) deliberately
                     live in the top-right Global Command Zone, not here. -->
                <TextBlock Text="Properties" Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" Margin="16,10,0,10"/>
              </StackPanel>

                <!-- Hint shown when nothing is selected (clip lists now live in the bottom dock). -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="24"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Reverse}">
                    <FontIcon Glyph="&#xE7C9;" FontSize="40" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                    <TextBlock Text="Select a clip in the timeline below to edit it." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                </StackPanel>

                <!-- Unified Inspector: one layout for every track. Binds to SelectedClip (whichever
                     track is selected); track-specific rows toggle via IsTrack1Selected /
                     IsOverlaySelected so Track 1 and Track 2+ share an identical skeleton. -->
                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                        Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Header: clip name + track label -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding SelectedClip.FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedTrackLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Zoom &amp; Motion cluster (identical for every track) -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Zoom &amp; Motion Controls" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Scroll/drag the video to frame it, then set Start / Mid / End. Same on every track."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Start" Width="60" FontWeight="SemiBold" Click="SetStart_Click" ToolTipService.ToolTip="Set Start Keyframe" Foreground="Cyan" />
                                    <Button Content="Mid" Width="60" FontWeight="SemiBold" Click="SetMid_Click" RightTapped="ClearMid_RightTapped" ToolTipService.ToolTip="Set Mid Keyframe (right-click to clear)" Foreground="DeepSkyBlue" />
                                    <Button Content="End" Width="60" FontWeight="SemiBold" Click="SetEnd_Click" ToolTipService.ToolTip="Set End Keyframe" Foreground="RoyalBlue" />
                                    <ToggleButton x:Name="RecordButton" Click="RecordButton_Click" ToolTipService.ToolTip="Record Motion (Track 1)" Height="32" Padding="8,4" CornerRadius="4"
                                                  IsEnabled="{Binding IsTrack1Selected}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <SymbolIcon x:Name="RecordIcon" Symbol="Video" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="Record" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Property rows. Each row is a 2-column grid; track-specific rows
                                 collapse cleanly (StackPanel removes the gap). Row order is the
                                 same skeleton for both tracks. -->
                            <StackPanel Spacing="12">
                                <!-- Start Time: shared row. Read-only for Track 1 (spine timing is
                                     derived from clip order); editable for overlays. -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Timeline Position" VerticalAlignment="Center" Width="120" TextWrapping="Wrap" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedClip.StartTimeSeconds, Mode=TwoWay, FallbackValue=0.0}"
                                               IsEnabled="{Binding IsOverlaySelected}" SmallChange="0.5" LargeChange="1.0" Minimum="0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="When this clip appears in the overall video. Track 1 is derived from clip order (read-only); overlays are free." />
                                </Grid>

                                <!-- Curve Profile: shared -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Curve Profile" VerticalAlignment="Center" Width="120" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedClip.CurveProfileIndex, Mode=TwoWay, FallbackValue=0}" HorizontalAlignment="Stretch">
                                        <x:String>Linear</x:String>
                                        <x:String>Bezier</x:String>
                                        <x:String>DirectorsArc</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- Trim: In / Out points into the source, in seconds. Numeric so an
                                     exact segment can be pulled from a long clip (the slider can't).
                                     Source length is read-only; Duration below = (Out - In) / Speed. -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Source Length" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" IsEnabled="False"
                                               Value="{Binding SelectedClip.SourceDurationSeconds, Mode=OneWay, FallbackValue=0.0}"
                                               SpinButtonPlacementMode="Hidden" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Clip Start" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedClip.VideoStartTime, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=0.0}"
                                               SmallChange="0.5" LargeChange="5" Minimum="0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="Where the clip begins inside the source video." />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Clip End" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedClip.VideoEndTime, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=0.0}"
                                               SmallChange="0.5" LargeChange="5" Minimum="0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="Where the clip ends inside the source video." />
                                </Grid>

                                <!-- Clip Duration on the timeline (derived from trim + speed; editable). -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Duration" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedClip.OpDuration, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=1.0}"
                                               SmallChange="0.5" LargeChange="1.0" Minimum="0.1" SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <!-- Playback Speed: shared. 0 = a still to Ken-Burns across the duration. -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Playback Speed" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.PlaybackSpeed, Mode=TwoWay, FallbackValue=1.0}"
                                               SmallChange="0.25" LargeChange="1.0" Minimum="0" Maximum="8" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="1 = normal, 3 = 3x faster, 0 = a still. Max 8." />
                                </Grid>

                                <!-- Volume: shared. Track 1 defaults full; overlays default muted (0). -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.Volume, Mode=TwoWay, FallbackValue=1.0}"
                                               SmallChange="0.1" LargeChange="0.25" Minimum="0" Maximum="1" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="Clip audio level: 0 = mute, 1 = full. Overlays start muted so PiPs don't fight the main track." />
                                </Grid>

                                <!-- Overlay placement — applies to overlay tracks; disabled (not
                                     hidden) for Track 1, which is always full-frame. Keeping the row
                                     present means the panel skeleton is identical for every clip and
                                     never reshuffles as the selection changes. -->
                                <TextBlock Text="Overlay Placement (PiP)" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PiP Width" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.PlacementWidth, Mode=TwoWay, FallbackValue=0.3}"
                                               IsEnabled="{Binding IsOverlaySelected}"
                                               SmallChange="0.05" LargeChange="0.1" Minimum="0.05" Maximum="1.0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="PiP box width as a fraction of the frame. Or drag a side/corner handle on the composite. Overlay tracks only." />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PiP Height" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.PlacementHeight, Mode=TwoWay, FallbackValue=0.3}"
                                               IsEnabled="{Binding IsOverlaySelected}"
                                               SmallChange="0.05" LargeChange="0.1" Minimum="0.05" Maximum="1.0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="PiP box height as a fraction of the frame. Reshape independently of width for any aspect. Overlay tracks only." />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Opacity" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.Opacity, Mode=TwoWay, FallbackValue=1.0}"
                                               IsEnabled="{Binding IsOverlaySelected}"
                                               SmallChange="0.1" LargeChange="0.25" Minimum="0" Maximum="1" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="Overlay opacity. Overlay tracks only." />
                                </Grid>

                                <!-- Transition — applies to Track 1 (how a clip hands off to the next);
                                     disabled for overlays. Same skeleton-stability rationale as above. -->
                                <TextBlock Text="Transition (Track 1)" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Transition Style" VerticalAlignment="Center" Width="120" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedClip.TransitionStyleIndex, Mode=TwoWay, FallbackValue=0}"
                                              IsEnabled="{Binding IsTrack1Selected}" HorizontalAlignment="Stretch">
                                        <x:String>HardSnap</x:String>
                                        <x:String>Crossfade</x:String>
                                        <x:String>CinematicBridge</x:String>
                                        <x:String>DipToColor</x:String>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Transition Length" VerticalAlignment="Center" Width="120" TextWrapping="Wrap" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedClip.TransitionDuration, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=0.0}"
                                               IsEnabled="{Binding SelectedClip.TransitionEditable}"
                                               SmallChange="0.1" LargeChange="0.5" Minimum="0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="HardSnap is an instant cut (0). Choose another Transition Style to set a length. Track 1 only." />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Foreground Layer: Floating Pill Control Bar -->
        <Border x:Name="FloatingPill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32" Padding="12,8"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="16"
                Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                RequestedTheme="Dark">
            <StackPanel Spacing="4">
                <Grid Margin="0,0,0,4" Padding="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Set the in/out point to the current playhead — the reliable way to trim a
                         long clip: scrub/click to the exact frame (zoom in first if you like), then
                         set the point here, no tiny handle to chase. -->
                    <Button Grid.Column="0" Click="SetInAtPlayhead_Click" IsEnabled="{Binding HasSelection}"
                            Height="28" Padding="8,0" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4"
                            ToolTipService.ToolTip="Set Clip Start to the playhead">
                        <TextBlock Text="[ In" />
                    </Button>
                    <local:TimelineRangeSlider Grid.Column="1"
                                               Maximum="{x:Bind ViewModel.CurrentOperationDurationSeconds, Mode=OneWay}"
                                               Position="{x:Bind ViewModel.CurrentOperationTimeSeconds, Mode=TwoWay}"
                                               TrimStart="{Binding SelectedClip.VideoStartTime, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}}"
                                               TrimEnd="{Binding SelectedClip.VideoEndTime, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}}"
                                               InteractionStarted="TimelineRangeSlider_InteractionStarted"
                                               InteractionCompleted="TimelineRangeSlider_InteractionCompleted" />
                    <Button Grid.Column="2" Click="SetOutAtPlayhead_Click" IsEnabled="{Binding HasSelection}"
                            Height="28" Padding="8,0" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4"
                            ToolTipService.ToolTip="Set Clip End to the playhead">
                        <TextBlock Text="Out ]" />
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Toggles Column -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton x:Name="ShuffleButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Toggle Shuffle">
                            <SymbolIcon Symbol="Shuffle" />
                        </ToggleButton>
                        <ToggleButton x:Name="LoopButton" IsChecked="{x:Bind ViewModel.IsLooping, Mode=TwoWay}" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Toggle Loop" Padding="0">
                            <FontIcon Glyph="&#xE8EE;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AutoPlayButton" IsChecked="{x:Bind ViewModel.IsAutoPlayEnabled, Mode=TwoWay}" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Toggle Auto-Play" Padding="0">
                            <FontIcon Glyph="&#xE173;" FontSize="14" />
                        </ToggleButton>
                        <Button x:Name="ResetClipButton" Click="ResetClip_Click" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Reset Clip Modifications" Padding="0" IsEnabled="{x:Bind ViewModel.SelectedTimelineNode.HasModifications, Mode=OneWay, FallbackValue=False}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="32" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="8,0" />

                    <!-- Transport Column -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="20" Click="Prev_Click" ToolTipService.ToolTip="Previous">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Width="48" Height="48" Background="Transparent" BorderThickness="0" CornerRadius="24" Click="PlayPause_Click" ToolTipService.ToolTip="Play/Pause">
                            <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                        </Button>
                        <Button x:Name="NextButton" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="20" Click="Next_Click" ToolTipService.ToolTip="Next">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                    </StackPanel>



                    <!-- Master playback speed (affects every track) -->
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="SPEED" FontSize="9" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox SelectedItem="{x:Bind ViewModel.PlaybackSpeed, Mode=TwoWay}"
                                      ItemsSource="{x:Bind ViewModel.AvailableSpeeds}"
                                      Width="60" Height="28" MinHeight="28" FontSize="11" Padding="8,0" VerticalAlignment="Center" ToolTipService.ToolTip="Master playback speed (affects all tracks)" />
                            <ToggleButton x:Name="StoryboardButton" IsChecked="{x:Bind ViewModel.IsStoryboardPinned, Mode=TwoWay}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Pin the Properties panel open (it opens automatically while editing)">
                                <SymbolIcon Symbol="List" />
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Track Dock: horizontal arrangement lanes (one per track).
             Auto-hides during playback (IsDockVisible) so the video gets the full canvas. -->
        <!-- Always visible now (it is just the compact timeline strip since the tile lanes were
             removed) so the playhead is watchable during playback too. -->
        <Border Grid.Row="1" x:Name="TrackDock"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="8,6"
                AllowDrop="True" DragOver="OverlaySection_DragOver" Drop="OverlaySection_Drop">
            <StackPanel Spacing="4">
                <!-- Proportional timeline + playhead (§7E/F). Activity view: spine (top row) +
                     one row per upper track, drawn to scale on one shared time axis, with the
                     playhead tracking story position. Track labels sit in a fixed-width gutter on
                     the left; the Canvas keeps x=0 == time 0. Laid out in code (TimelineBar_*). -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Canvas x:Name="TimelineLabels" Grid.Column="0" Background="Transparent" IsHitTestVisible="False" />
                        <Canvas x:Name="TimelineBar" Grid.Column="1" Height="52" HorizontalAlignment="Stretch"
                                Background="Transparent" SizeChanged="TimelineBar_SizeChanged"
                                PointerPressed="TimelineBar_PointerPressed"
                                PointerMoved="TimelineBar_PointerMoved"
                                PointerReleased="TimelineBar_PointerReleased">
                            <!-- A real ContextFlyout: the platform shows this on right-click /
                                 menu key / long-press, rather than us hand-rolling it from a
                                 pointer event (which never fired reliably). -->
                            <Canvas.ContextFlyout>
                                <MenuFlyout Opening="TimelineContextMenu_Opening">
                                    <MenuFlyoutItem x:Name="TimelineSplitItem" Text="Split at playhead" Click="TimelineSplit_Click" />
                                    <MenuFlyoutItem x:Name="TimelineSnapshotItem" Text="Snapshot (10s still)" Click="TimelineSnapshot_Click"
                                                    ToolTipService.ToolTip="Freeze this frame as a 10s still with a slow Ken Burns push-in" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="TimelineDuplicateItem" Text="Duplicate" Click="TimelineDuplicate_Click" />
                                    <MenuFlyoutItem x:Name="TimelineRemoveItem" Text="Remove" Click="TimelineRemove_Click" />
                                </MenuFlyout>
                            </Canvas.ContextFlyout>
                        </Canvas>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
