<UserControl
    x:Class="ModernImageViewer.VideoDirector.Views.VideoDirectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ModernImageViewer.VideoDirector.Views"
    xmlns:models="using:ModernImageViewer.VideoDirector.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DirectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <local:EmptyToVisConverter x:Key="EmptyToVisConverter" />
            <local:NullToVisConverter x:Key="NullToVisConverter" />
            <local:NullToBoolConverter x:Key="NullToBoolConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Black" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />    <!-- Canvas area (player + right panel + floating pill) -->
            <RowDefinition Height="Auto" /> <!-- Bottom track dock (collapses when hidden) -->
        </Grid.RowDefinitions>

        <!-- Background Layer: Full Bleed Immersive Player -->
        <local:DirectorPlayerControl x:Name="PlayerControl" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Mode indicator + Exit-to-Arrange (Exit shows only in Edit mode).
             Top margin clears the window's title-bar drag region so the button is clickable. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,52,16,16">
            <Border Background="#99000000" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ModeLabel, Mode=OneWay}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <Button Click="ExitToArrange_Click" Padding="10,4" CornerRadius="4"
                    Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                    ToolTipService.ToolTip="Exit edit — back to Arrange (the whole composite)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Back" />
                    <TextBlock Text="Exit" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Foreground Layer: Floating Edit Badge -->
        <Border x:Name="EditModeBadge" Background="#D9E81123" CornerRadius="8" Padding="16,8" 
                Visibility="{x:Bind ViewModel.IsRecordingMotion, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Vertical" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Video" Foreground="White" />
                    <TextBlock x:Name="EditModeText" Text="Live Recording: Move Camera" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Zoom with scroll wheel. Pan by dragging. Set speed to &gt;0x to capture." Foreground="White" Opacity="0.8" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Foreground Layer: Right Side Panel (The Storyboard) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="380" 
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" 
                CornerRadius="8,0,0,8" Margin="0,48,0,0"
                Visibility="{x:Bind ViewModel.IsStoryboardVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- CommandBar -->
                    <RowDefinition Height="*" />    <!-- Inspector area -->
                </Grid.RowDefinitions>

                <CommandBar DefaultLabelPosition="Right" Background="Transparent" Padding="4">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton Icon="Save" Label="Save" Click="Save_Click" />
                        <AppBarButton Icon="OpenFile" Label="Load" Click="Load_Click" />
                        <AppBarButton Icon="Delete" Label="Clear" Click="Clear_Click" />
                    </CommandBar.PrimaryCommands>
                    <CommandBar.Content>
                        <TextBlock Text="Inspector" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </CommandBar.Content>
                </CommandBar>

                <!-- Hint shown when nothing is selected (clip lists now live in the bottom dock). -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="24"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Reverse}">
                    <FontIcon Glyph="&#xE7C9;" FontSize="40" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                    <TextBlock Text="Select a clip in the timeline below to edit it." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                </StackPanel>

                <!-- Unified Inspector: one layout for every track. Binds to SelectedClip (whichever
                     track is selected); track-specific rows toggle via IsTrack1Selected /
                     IsOverlaySelected so Track 1 and Track 2+ share an identical skeleton. -->
                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                        Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Header: clip name + track label -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding SelectedClip.FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Track 1 · spine" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding IsTrack1Selected, Converter={StaticResource BoolToVisConverter}}" />
                                <TextBlock Text="Track 2 · overlay (PiP)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding IsOverlaySelected, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>

                            <!-- Zoom &amp; Motion cluster (identical for every track) -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Zoom &amp; Motion Controls" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Scroll/drag the video to frame it, then set Start / Mid / End. Same on every track."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Start" Width="60" FontWeight="SemiBold" Click="SetStart_Click" ToolTipService.ToolTip="Set Start Keyframe" Foreground="Cyan" />
                                    <Button Content="Mid" Width="60" FontWeight="SemiBold" Click="SetMid_Click" RightTapped="ClearMid_RightTapped" ToolTipService.ToolTip="Set Mid Keyframe (right-click to clear)" Foreground="DeepSkyBlue" />
                                    <Button Content="End" Width="60" FontWeight="SemiBold" Click="SetEnd_Click" ToolTipService.ToolTip="Set End Keyframe" Foreground="RoyalBlue" />
                                    <ToggleButton x:Name="RecordButton" Click="RecordButton_Click" ToolTipService.ToolTip="Record Motion" Height="32" Padding="8,4" CornerRadius="4"
                                                  Visibility="{Binding IsTrack1Selected, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <SymbolIcon x:Name="RecordIcon" Symbol="Video" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="Record" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Property rows. Each row is a 2-column grid; track-specific rows
                                 collapse cleanly (StackPanel removes the gap). Row order is the
                                 same skeleton for both tracks. -->
                            <StackPanel Spacing="12">
                                <!-- Start Time: shared row. Read-only for Track 1 (spine timing is
                                     derived from clip order); editable for overlays. -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start Time (s)" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedClip.StartTimeSeconds, Mode=TwoWay, FallbackValue=0.0}"
                                               IsEnabled="{Binding IsOverlaySelected}" SmallChange="0.5" LargeChange="1.0" Minimum="0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="When this clip starts. Track 1 is derived from clip order (read-only); overlays are free." />
                                </Grid>

                                <!-- Curve Profile: shared -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Curve Profile" VerticalAlignment="Center" Width="120" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedClip.CurveProfileIndex, Mode=TwoWay, FallbackValue=0}" HorizontalAlignment="Stretch">
                                        <x:String>Linear</x:String>
                                        <x:String>Bezier</x:String>
                                        <x:String>DirectorsArc</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- Clip Duration: shared -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Duration (s)" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedClip.OpDuration, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=1.0}"
                                               SmallChange="0.5" LargeChange="1.0" Minimum="0.1" SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <!-- Playback Speed: Track 1 only -->
                                <Grid ColumnSpacing="12" Visibility="{Binding IsTrack1Selected, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Playback Speed" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.PlaybackSpeed, Mode=TwoWay, FallbackValue=1.0}"
                                               SmallChange="0.1" LargeChange="0.5" Minimum="0" SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <!-- PiP Width: overlay only -->
                                <Grid ColumnSpacing="12" Visibility="{Binding IsOverlaySelected, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PiP Width" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.PlacementWidth, Mode=TwoWay, FallbackValue=0.3}"
                                               SmallChange="0.05" LargeChange="0.1" Minimum="0.05" Maximum="1.0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="PiP box width as a fraction of the frame. Or drag a side/corner handle on the composite." />
                                </Grid>

                                <!-- PiP Height: overlay only -->
                                <Grid ColumnSpacing="12" Visibility="{Binding IsOverlaySelected, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PiP Height" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.PlacementHeight, Mode=TwoWay, FallbackValue=0.3}"
                                               SmallChange="0.05" LargeChange="0.1" Minimum="0.05" Maximum="1.0" SpinButtonPlacementMode="Inline"
                                               ToolTipService.ToolTip="PiP box height as a fraction of the frame. Reshape independently of width for any aspect." />
                                </Grid>

                                <!-- Opacity: overlay only -->
                                <Grid ColumnSpacing="12" Visibility="{Binding IsOverlaySelected, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Opacity" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="2" Value="{Binding SelectedClip.Opacity, Mode=TwoWay, FallbackValue=1.0}"
                                               SmallChange="0.1" LargeChange="0.25" Minimum="0" Maximum="1" SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <!-- Transition Out Style: Track 1 only -->
                                <Grid ColumnSpacing="12" Visibility="{Binding IsTrack1Selected, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Transition Out" VerticalAlignment="Center" Width="120" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedClip.TransitionStyleIndex, Mode=TwoWay, FallbackValue=0}" HorizontalAlignment="Stretch">
                                        <x:String>HardSnap</x:String>
                                        <x:String>Crossfade</x:String>
                                        <x:String>CinematicBridge</x:String>
                                        <x:String>DipToColor</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- Transition Out Duration: Track 1 only -->
                                <Grid ColumnSpacing="12" Visibility="{Binding IsTrack1Selected, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Transition (s)" VerticalAlignment="Center" Width="120" />
                                    <NumberBox Grid.Column="1" local:NumberBoxExtensions.FractionDigits="1" Value="{Binding SelectedClip.TransitionDuration, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}, FallbackValue=0.0}"
                                               SmallChange="0.1" LargeChange="0.5" Minimum="0" SpinButtonPlacementMode="Inline" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Foreground Layer: Floating Pill Control Bar -->
        <Border x:Name="FloatingPill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32" Padding="12,8"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="16"
                Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                RequestedTheme="Dark">
            <StackPanel Spacing="4">
                <Grid Margin="0,0,0,4" Padding="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:TimelineRangeSlider Grid.Column="0" Grid.ColumnSpan="3"
                                               Maximum="{x:Bind ViewModel.CurrentOperationDurationSeconds, Mode=OneWay}"
                                               Position="{x:Bind ViewModel.CurrentOperationTimeSeconds, Mode=TwoWay}"
                                               TrimStart="{Binding SelectedTimelineNode.VideoStartTime, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}}"
                                               TrimEnd="{Binding SelectedTimelineNode.VideoEndTime, Mode=TwoWay, Converter={StaticResource TimeSpanToDoubleSecondsConverter}}"
                                               InteractionStarted="TimelineRangeSlider_InteractionStarted"
                                               InteractionCompleted="TimelineRangeSlider_InteractionCompleted" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Toggles Column -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton x:Name="ShuffleButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Toggle Shuffle">
                            <SymbolIcon Symbol="Shuffle" />
                        </ToggleButton>
                        <ToggleButton x:Name="LoopButton" IsChecked="{x:Bind ViewModel.IsLooping, Mode=TwoWay}" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Toggle Loop" Padding="0">
                            <FontIcon Glyph="&#xE8EE;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AutoPlayButton" IsChecked="{x:Bind ViewModel.IsAutoPlayEnabled, Mode=TwoWay}" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Toggle Auto-Play" Padding="0">
                            <FontIcon Glyph="&#xE173;" FontSize="14" />
                        </ToggleButton>
                        <Button x:Name="ResetClipButton" Click="ResetClip_Click" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="Reset Clip Modifications" Padding="0" IsEnabled="{x:Bind ViewModel.SelectedTimelineNode.HasModifications, Mode=OneWay, FallbackValue=False}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="32" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="8,0" />

                    <!-- Transport Column -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="20" Click="Prev_Click" ToolTipService.ToolTip="Previous">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Width="48" Height="48" Background="Transparent" BorderThickness="0" CornerRadius="24" Click="PlayPause_Click" ToolTipService.ToolTip="Play/Pause">
                            <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                        </Button>
                        <Button x:Name="NextButton" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="20" Click="Next_Click" ToolTipService.ToolTip="Next">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                    </StackPanel>



                    <!-- Global Stack -->
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="GLOBAL" FontSize="9" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox SelectedItem="{x:Bind ViewModel.PlaybackSpeed, Mode=TwoWay}" 
                                      ItemsSource="{x:Bind ViewModel.AvailableSpeeds}"
                                      Width="60" Height="28" MinHeight="28" FontSize="11" Padding="8,0" VerticalAlignment="Center" ToolTipService.ToolTip="Global Speed" />
                            <ToggleButton x:Name="StoryboardButton" IsChecked="{x:Bind ViewModel.IsStoryboardVisible, Mode=TwoWay}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Toggle Storyboard">
                                <SymbolIcon Symbol="List" />
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Track Dock: horizontal arrangement lanes (one per track).
             Auto-hides during playback (IsDockVisible) so the video gets the full canvas. -->
        <!-- Always visible now (it is just the compact timeline strip since the tile lanes were
             removed) so the playhead is watchable during playback too. -->
        <Border Grid.Row="1" x:Name="TrackDock"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="8,6"
                AllowDrop="True" DragOver="OverlaySection_DragOver" Drop="OverlaySection_Drop">
            <StackPanel Spacing="4">
                <!-- Proportional timeline + playhead (§7E/F). Activity view: spine (top) + overlay
                     blocks (below) drawn to scale on one shared time axis; the playhead tracks the
                     story position and (next) scrubs. Laid out in code (TimelineBar_*). -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                    <Canvas x:Name="TimelineBar" Height="52" HorizontalAlignment="Stretch"
                            Background="Transparent" SizeChanged="TimelineBar_SizeChanged"
                            PointerPressed="TimelineBar_PointerPressed"
                            PointerMoved="TimelineBar_PointerMoved"
                            PointerReleased="TimelineBar_PointerReleased" />
                </Border>

                <!-- Track legend + add. The proportional timeline above is now the single track
                     display (replaces the old equal-tile lanes); click a block to select a clip. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#3B82F6" />
                        <TextBlock Text="Track 1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#F59E0B" />
                        <TextBlock Text="Track 2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="3" Click="AddOverlay_Click" Padding="8,2"
                            ToolTipService.ToolTip="Add an overlay clip to Track 2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Add Overlay" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
