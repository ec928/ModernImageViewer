<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModernImageViewer.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <Style x:Key="AboutGlyph" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="AboutItemTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="AboutItemBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </ContentDialog.Resources>

    <Grid x:Name="RootPanel" Width="500" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IsTabStop=False keeps the dialog from focusing something deep in this list on open. -->
        <ScrollViewer x:Name="BodyScroller"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="560"
                      IsTabStop="False">
            <StackPanel Spacing="0">

                <!-- Header band. -->
                <Grid CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Border x:Name="HeroTint" CornerRadius="10"/>
                    <Grid Padding="20,18" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="AppIconImage" Width="64" Height="64" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Modern Image Viewer" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="A fast, hardware-accelerated image, comic book and collage viewer."
                                       FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <!-- Filled at runtime from the assembly version, never hardcoded: a stale
                                 number here would be a lie the moment the version is bumped. -->
                            <TextBlock x:Name="VersionText" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- One column of six; UseWideLayout() turns it into two columns of three in a wide window. -->
                <Grid x:Name="FeatureGrid" Margin="2,14,12,0" ColumnSpacing="14" RowSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <FontIcon Grid.Row="0" Glyph="&#xEB9F;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="Tile, list and instant preview" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Browse large folders in a row-fitted tile grid or high-density list with a live metadata and image preview bar, tinted by the current image."/>
                    </StackPanel>

                    <FontIcon Grid.Row="1" Glyph="&#xEE49;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Multi-View and collages" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Compare up to 16 images in fluid grids with hero layouts, draggable edges, floating shaped cells, custom frames, and export to JPEG, PNG, or the clipboard."/>
                    </StackPanel>

                    <FontIcon Grid.Row="2" Glyph="&#xE768;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Shows, 3D parallax and music" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Play any folder or selection as a Multi-Image, Cinematic, or 3D Parallax show with camera motion and transitions cut to your music's beats."/>
                    </StackPanel>

                    <FontIcon Grid.Row="3" Glyph="&#xE736;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="Comic book reader (CBR and CBZ)" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Open .cbz and .cbr archives directly like folders with responsive two-page spreads (toggle with B) that keep covers and wide pages solo."/>
                    </StackPanel>

                    <FontIcon Grid.Row="4" Glyph="&#xE8A7;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBlock Text="Tear-off reference windows" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Middle-click or drag any image out into its own borderless floating window for multi-monitor reference, and save up to three window sizes (Ctrl+1–3)."/>
                    </StackPanel>

                    <FontIcon Grid.Row="5" Glyph="&#xE72E;" Style="{StaticResource AboutGlyph}"/>
                    <StackPanel Grid.Row="5" Grid.Column="1">
                        <TextBlock Text="Fast, private and portable" Style="{StaticResource AboutItemTitle}"/>
                        <TextBlock Style="{StaticResource AboutItemBody}"
                                   Text="Direct2D GPU rendering with tiered async decoding, ICC color profiles, and animated GIFs. Portable with no account, ads, or registry changes."/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Free and open source under the MIT licence. Unsigned build, so Windows SmartScreen may warn on first launch."
                           TextWrapping="Wrap" FontSize="12" Margin="2,14,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Report a problem" HorizontalAlignment="Stretch" Click="ReportButton_Click"/>
            <Button Grid.Column="1" Content="View on GitHub" HorizontalAlignment="Stretch" Click="ProjectButton_Click"/>
            <Button Grid.Column="2" Content="Close" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</ContentDialog>
