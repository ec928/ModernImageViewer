<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModernImageViewer.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="About Modern Image Viewer"
    PrimaryButtonText="Report a problem"
    SecondaryButtonText="View on GitHub"
    CloseButtonText="Close"
    DefaultButton="Close"
    PrimaryButtonClick="ReportButton_Click"
    SecondaryButtonClick="ProjectButton_Click">

    <ContentDialog.Resources>
        <Style x:Key="AboutSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="80"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style x:Key="AboutBullet" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
    </ContentDialog.Resources>

    <!-- IsTabStop=False and TabNavigation=Once keep the dialog from focusing something
         deep in this list on open, which scrolled it to the bottom and hid the brand. -->
    <ScrollViewer x:Name="BodyScroller"
                  VerticalScrollBarVisibility="Auto"
                  MaxHeight="400" IsTabStop="False">
        <StackPanel Width="430" Spacing="0">

            <!-- Brand -->
            <TextBlock Text="Modern Image Viewer"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <!-- Filled at runtime from the assembly version, never hardcoded: a stale
                 number here would be a lie the moment the version is bumped. -->
            <TextBlock x:Name="VersionText"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,0"/>

            <TextBlock Text="A hardware-accelerated image viewer for large folders of high-resolution images. Tear any image off into its own window, build a collage, or run a cinematic slideshow with Ken Burns moves you can direct."
                       TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="VIEWING" Style="{StaticResource AboutSectionHeader}"/>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  "/><Run Text="Tear-off viewports" FontWeight="SemiBold"/><Run Text=" — detach any image into its own borderless window for a second monitor or as a reference overlay."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  GPU rendering through Win2D (Direct2D), with zoom, pan, rotation and gamma applied on the graphics card."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  Animated GIFs play with correct frame offsets and disposal, not just the first frame."/>
            </TextBlock>

            <TextBlock Text="CINEMATIC AND COLLAGE (BETA)" Style="{StaticResource AboutSectionHeader}"/>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  "/><Run Text="Cinematic slideshow" FontWeight="SemiBold"/><Run Text=" — press Play and the camera picks a Ken Burns move per image, framing on faces and detail, with crossfades between slides."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  Direct the show yourself: set the start and end frames of a Ken Burns move, change its curve and how long that slide holds, then reorder, hide or duplicate slides."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  Save a show and reload it later. Video Director, the companion app this one can launch, covers multi-track editing and MP4 export."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  Collage editor for arranging, rotating and exporting a composition at native resolution."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  Both are still being hardened. Save often."/>
            </TextBlock>

            <TextBlock Text="LARGE FOLDERS" Style="{StaticResource AboutSectionHeader}"/>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  Tiered decoding — thumbnail, fast preview, display and high fidelity — so thousands of 10 MB+ images browse without stalling or growing without bound."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  Images ahead of and behind you are decoded in advance and released once you move away."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  The grid follows changes on disk, and rename and delete (to the Recycle Bin) work in place."/>
            </TextBlock>

            <TextBlock Text="FORMATS AND STORAGE" Style="{StaticResource AboutSectionHeader}"/>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  JPEG, PNG, GIF, BMP, TIFF and WebP out of the box. HEIC/HEIF and AVIF need the matching Windows codecs; without them the viewer says so rather than showing a blank canvas."/>
            </TextBlock>
            <TextBlock Style="{StaticResource AboutBullet}">
                <Run Text="•  Portable: no installer and no registry changes. Settings live in your local app data folder."/>
            </TextBlock>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,20,0,14"/>

            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="Free and open source under the MIT licence. Unsigned build, so Windows SmartScreen may warn on first launch."/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
