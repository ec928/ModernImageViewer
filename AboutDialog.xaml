<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModernImageViewer.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="About Modern Image Viewer">

    <ContentDialog.Resources>
        <Style x:Key="AboutSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="80"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style x:Key="AboutBullet" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="440" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IsTabStop=False keeps the dialog from focusing something deep in this list on open. -->
        <ScrollViewer x:Name="BodyScroller"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="380" IsTabStop="False">
            <StackPanel Spacing="0" Padding="0,0,12,0">

                <!-- Brand -->
                <TextBlock Text="Modern Image Viewer"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <!-- Filled at runtime from the assembly version, never hardcoded: a stale
                     number here would be a lie the moment the version is bumped. -->
                <TextBlock x:Name="VersionText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0"/>

                <TextBlock Text="A fast, hardware-accelerated image and comic book viewer built with WinUI 3 and Win2D. Browse large high-resolution folders in Tile or List mode, read CBR and CBZ comics with automatic two-page spreads, tear images off into floating reference windows, or direct a cinematic Ken Burns slideshow."
                           TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock Text="Viewing and layout" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Tile &amp; List View modes" FontWeight="SemiBold"/><Run Text=" &#x2014; switch between resizable thumbnail grids and high-density multi-column lists with a live metadata and image preview bar."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Multi-View" FontWeight="SemiBold"/><Run Text=" &#x2014; compare up to 16 photos in rows or columns of your choosing, with hero layouts, draggable edges, Alt+drag to swap, and JPEG export."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Window &amp; Tile Size presets" FontWeight="SemiBold"/><Run Text=" &#x2014; save up to three window and tile size states (Ctrl+1, Ctrl+2, Ctrl+3) to jump between compact browsing and wide two-page layouts."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Tear-off viewports" FontWeight="SemiBold"/><Run Text=" &#x2014; middle-click or drag any image out into its own borderless floating window for multi-monitor reference overlays."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Direct2D GPU rendering" FontWeight="SemiBold"/><Run Text=" &#x2014; smooth zoom, pan, rotation, ICC color profiles, real-time gamma adjustment, and full multi-frame animated GIF playback."/>
                </TextBlock>

                <TextBlock Text="Comic book reader (CBR / CBZ)" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Native archive browsing" FontWeight="SemiBold"/><Run Text=" &#x2014; open .cbz (ZIP) and .cbr (RAR) comic archives directly like folders without extracting files to disk."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Responsive two-page spread" FontWeight="SemiBold"/><Run Text=" &#x2014; automatically displays side-by-side double-page spreads when the window is stretched wide enough (toggle anytime with B), while keeping covers and wide landscapes on a single page."/>
                </TextBlock>

                <TextBlock Text="Cinematic and collage (Beta)" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Cinematic slideshow" FontWeight="SemiBold"/><Run Text=" &#x2014; press Play for automated Ken Burns camera moves with smart subject framing and smooth crossfades between slides."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Custom direction &amp; Video Director" FontWeight="SemiBold"/><Run Text=" &#x2014; customize start/end frames, easing curves, and slide timing, or launch Video Director for multi-track editing and MP4 export."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Collage editor" FontWeight="SemiBold"/><Run Text=" &#x2014; arrange, rotate, and export multi-image compositions at native resolution."/>
                </TextBlock>

                <TextBlock Text="Performance and formats" Style="{StaticResource AboutSectionHeader}"/>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Tiered async decoding" FontWeight="SemiBold"/><Run Text=" &#x2014; thumbnail, fast preview, display, and high-fidelity stages with predictive lookahead caching keep 10 MB+ image libraries responsive and memory-bounded."/>
                </TextBlock>
                <TextBlock Style="{StaticResource AboutBullet}">
                    <Run Text="&#x2022;  "/><Run Text="Formats &amp; portability" FontWeight="SemiBold"/><Run Text=" &#x2014; JPEG, PNG, GIF, BMP, TIFF, WebP, CBZ, and CBR out of the box (plus HEIC/HEIF and AVIF via Windows codecs). Portable with no registry changes; settings live in your local app data folder."/>
                </TextBlock>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,20,0,14"/>

                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Free and open source under the MIT licence. Unsigned build, so Windows SmartScreen may warn on first launch."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Report a problem" HorizontalAlignment="Stretch" Click="ReportButton_Click"/>
            <Button Grid.Column="1" Content="View on GitHub" HorizontalAlignment="Stretch" Click="ProjectButton_Click"/>
            <Button Grid.Column="2" Content="Close" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</ContentDialog>
