<UserControl
    x:Class="ModernImageViewer.ImageViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernImageViewer"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#FF050505" RequestedTheme="Dark">
        <Grid.Resources>
            <Storyboard x:Name="FadeInStoryboard">
                <DoubleAnimation Storyboard.TargetName="UnifiedHud" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="TopLeftInfoOverlay" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="AnimationHud" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25" />

                <DoubleAnimation Storyboard.TargetName="HudTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <DoubleAnimation Storyboard.TargetName="AnimHudTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="FadeOutStoryboard">
                <DoubleAnimation Storyboard.TargetName="UnifiedHud" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="TopLeftInfoOverlay" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="AnimationHud" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25" />

                <DoubleAnimation Storyboard.TargetName="HudTranslate" Storyboard.TargetProperty="Y" To="15" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <DoubleAnimation Storyboard.TargetName="AnimHudTranslate" Storyboard.TargetProperty="Y" To="15" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Image x:Name="PlaceholderImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="4" Visibility="Collapsed" />
        <canvas:CanvasControl x:Name="PreviewCanvas" Draw="PreviewCanvas_Draw" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="5" />

        <ScrollViewer x:Name="ImageScroll" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="20" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Auto" ViewChanged="ImageScroll_ViewChanged" SizeChanged="ImageScroll_SizeChanged" Canvas.ZIndex="10">
            <Grid x:Name="ScrollViewportGrid" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid x:Name="DummyScrollExtent" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </ScrollViewer>

        <Grid x:Name="InputOverlay" Background="#01000000" Canvas.ZIndex="50" 
              PointerPressed="InputOverlay_PointerPressed" 
              PointerMoved="InputOverlay_PointerMoved" 
              PointerReleased="InputOverlay_PointerReleased" 
              PointerCanceled="InputOverlay_PointerCanceled"
              PointerWheelChanged="InputOverlay_PointerWheelChanged"
              Tapped="InputOverlay_Tapped"
              DoubleTapped="InputOverlay_DoubleTapped">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="SizeToImageMenuItem" Text="Size Window to Image" Click="SizeToImage_Click" Visibility="Collapsed">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Placeholder"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator x:Name="SizeToImageSeparator" Visibility="Collapsed" />

                    <MenuFlyoutItem Text="Zoom to 100%" Click="ZoomToActualSize_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="ZoomIn"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Fit to Window (MB3)" Click="SizeToWindow_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="ZoomOut"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Fullscreen / Maximize (F11)" Click="ToggleFullscreen_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="FullScreen"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutSubItem Text="Gamma Level">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE793;"/>
                        </MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem x:Name="Gamma16" Text="1.6" Tag="1.6" Click="SetGamma_Click" GroupName="GammaGroup"/>
                        <RadioMenuFlyoutItem x:Name="Gamma18" Text="1.8" Tag="1.8" Click="SetGamma_Click" GroupName="GammaGroup"/>
                        <RadioMenuFlyoutItem x:Name="Gamma20" Text="2.0" Tag="2.0" Click="SetGamma_Click" GroupName="GammaGroup"/>
                        <RadioMenuFlyoutItem x:Name="Gamma22" Text="2.2 (Default)" Tag="2.2" Click="SetGamma_Click" IsChecked="True" GroupName="GammaGroup"/>
                        <RadioMenuFlyoutItem x:Name="Gamma24" Text="2.4" Tag="2.4" Click="SetGamma_Click" GroupName="GammaGroup"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator/>

                    <MenuFlyoutSubItem x:Name="DetachLimitMenu" Text="Detach Size Limit">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE740;"/>
                        </MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem x:Name="LimitZoom" Text="Current Zoom" Tag="0" Click="SetDetachLimit_Click" IsChecked="True" GroupName="DetachLimitGroup"/>
                        <RadioMenuFlyoutItem x:Name="Limit1200" Text="1200p" Tag="2" Click="SetDetachLimit_Click" GroupName="DetachLimitGroup"/>
                        <RadioMenuFlyoutItem x:Name="Limit1080" Text="1080p" Tag="1" Click="SetDetachLimit_Click" GroupName="DetachLimitGroup"/>
                        <RadioMenuFlyoutItem x:Name="Limit800" Text="800p" Tag="3" Click="SetDetachLimit_Click" GroupName="DetachLimitGroup"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator/>

                    <MenuFlyoutItem Text="Add to Collage" Click="AddToCollage_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Pictures"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Play Cinematic Slideshow" Click="PlayCinematic_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Play" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>

                    <MenuFlyoutItem Text="Edit Image" Click="EditImage_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Edit"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Rename" Click="RenameImage_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Rename"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete (Del)" Click="DeleteImage_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Delete"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>

                    <MenuFlyoutItem Text="Show in Explorer" Click="ShowInExplorer_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Folder"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>

                    <MenuFlyoutItem x:Name="DetachMenuItem" Text="Detach Image" Click="DetachImage_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="NewWindow"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Close (Esc)" Click="ClosePreview_Click">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Cancel"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
        </Grid>

        <Grid x:Name="TopLeftInfoOverlay" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,60,0,0" Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="60">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="HudFileName" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="350" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HudSecondaryInfo" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock x:Name="HudZoomInfo" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.5"/>
                        <TextBlock x:Name="HudFidelity" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AnimationHud" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,135" Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="60" Visibility="Collapsed"
              PointerEntered="Hud_PointerEntered" PointerExited="Hud_PointerExited">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="AnimHudTranslate" Y="15" />
            </Grid.RenderTransform>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="12,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AnimPrevButton" Click="AnimPrev_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Previous Frame (&lt;)" Padding="6">
                        <SymbolIcon Symbol="Previous"/>
                    </Button>
                    <Button x:Name="AnimPlayPauseButton" Click="AnimPlayPause_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Play/Pause (Space)" Padding="6">
                        <SymbolIcon x:Name="AnimPlayPauseIcon" Symbol="Pause"/>
                    </Button>
                    <Button x:Name="AnimNextButton" Click="AnimNext_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Next Frame (&gt;)" Padding="6">
                        <SymbolIcon Symbol="Next"/>
                    </Button>
                    <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,6" Opacity="0.4"/>
                    <TextBlock x:Name="AnimFrameCounter" Text="1 / 1" VerticalAlignment="Center" Margin="4,0,8,0" Style="{ThemeResource CaptionTextBlockStyle}" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="UnifiedHud" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,80" Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="60"
              PointerEntered="Hud_PointerEntered" PointerExited="Hud_PointerExited">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HudTranslate" Y="15" />
            </Grid.RenderTransform>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="24" Padding="16,6">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="ZoomModeButton" Click="ToggleZoomMode_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Toggle Zoom Mode (Mouse Thumb Button)" Padding="6">
                            <FontIcon x:Name="ZoomModeIcon" Glyph="&#xE71E;"/>
                        </Button>
                        <Button x:Name="MinimizeButton" Click="Minimize_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Minimize" Padding="6" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE921;"/>
                        </Button>
                        <Button x:Name="DetachButton" Click="DetachImage_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Detach" Padding="6">
                            <SymbolIcon Symbol="NewWindow"/>
                        </Button>
                        <Button Click="ToggleFullscreen_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Fullscreen / Maximize (F11)" Padding="6">
                            <SymbolIcon Symbol="FullScreen"/>
                        </Button>
                    </StackPanel>
                    <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" Opacity="0.4"/>
                    <Button Click="ClosePreview_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Close (Esc)" Padding="6">
                        <SymbolIcon Symbol="Cancel"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>