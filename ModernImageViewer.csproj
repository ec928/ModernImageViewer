<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<WindowsPackageType>None</WindowsPackageType>
	<SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
	<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>  
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ModernImageViewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>

    <!--
      Single source of truth for the shipped version. Until 0.10.0 these were unset, so
      every build stamped the SDK default 1.0.0.0 and the v0.9.0 zip shipped an exe
      whose properties disagreed with its own release tag. Bump Version here when
      tagging; the release tag, the zip name and the exe properties then all agree.
    -->
    <Version>0.15.3</Version>
    <AssemblyVersion>0.15.3.0</AssemblyVersion>
    <FileVersion>0.15.3.0</FileVersion>
    <Product>ModernImageViewer</Product>

    <!--
      Output straight to bin\<Platform>\<Config>\ instead of the default
      bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\. The framework and RID are
      already fixed by this project, so the extra two levels only lengthen the path.
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Pinned so EVERY publish lands in the Release folder, however it is invoked.
         Without it a bare `dotnet publish` uses the SDK default and buries the output
         in bin\x64\Release\win-x64\publish\ - a nested copy of the folder it
         just built, leaving two candidate exes to choose between. -->
    <PublishDir>bin\$(Platform)\$(Configuration)\</PublishDir>

    <!--
      Ship English resources only. Note this handles .NET satellite assemblies but NOT
      WinUI's .mui files - those are Win32 MUI resources and need the target below.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    WinUI emits ~86 locale folders of .mui resources into the output. About 3.6 MB, but
    the real cost is 86 directories to scroll past every time you open the folder looking
    for the exe. English is kept; the rest go.

    Consequence: WinUI's own system strings (dialog buttons and similar) appear in English
    on a non-English Windows. This app has no localised resources of its own, so nothing
    else changes. Delete this target to restore every language.
  -->
  <Target Name="TrimLocaleResourceFolders" AfterTargets="Build;Publish">
    <ItemGroup>
      <_AllMui Include="$(OutDir)*\*.mui" />
      <_KeepMui Include="$(OutDir)en*\*.mui" />
      <_DropMui Include="@(_AllMui)" Exclude="@(_KeepMui)" />
    </ItemGroup>
    <Delete Files="@(_DropMui)" ContinueOnError="true" />
    <RemoveDir Directories="@(_DropMui->'%(RootDir)%(Directory)'->Distinct())" ContinueOnError="true" />
  </Target>
  <ItemGroup>
    <None Remove="CollageCanvas.xaml" />
    <None Remove="CollageEditorWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="ModernImageViewer.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\ParentFolder.png" />
    <EmbeddedResource Include="Assets\ParentFolder.png">
      <LogicalName>ModernImageViewer.Assets.ParentFolder.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    The test project lives at tests\ModernImageViewer.Tests so a clone gets it. This app
    uses the SDK's default **\*.cs glob, which would otherwise pull the test sources into
    the app and fail the build on the missing xunit reference. Exclude the whole folder.
  -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <ApplicationDefinition Remove="tests\**" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="SharpCompress" Version="0.39.0" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="CollageEditorWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="CollageCanvas.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="ImageViewerControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="DetachedWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Collage\" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Cinematic\CinematicWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
    <!-- Deliberately NOT single-file: the self-extract step dominated cold start. -->
    <PublishSingleFile>False</PublishSingleFile>
    <ApplicationIcon>ModernImageViewer.ico</ApplicationIcon>
  </PropertyGroup>


  <!--
    WindowsAppSDK self-contained deployment ships the whole Windows AI stack: the native
    ML runtime (onnxruntime + DirectML, ~38 MB), its managed wrapper, and the projection
    assemblies and winmds for AI Foundation, Machine Learning, Text, Imaging, Vision,
    Semantic Search, Content Safety and the NPU workload selector (~5 MB more). The SDK's
    own targets only suppress the native pair for Framework/Passthrough modes, not
    SelfContained, and never touch the rest.

    This app uses none of it. Note Microsoft.Graphics.Imaging is the AI imaging API
    (super-resolution, object removal) and is unrelated to Win2D, which lives in
    Microsoft.Graphics.Canvas and is NOT matched by these patterns.

    Deleted from $(OutDir) rather than filtered from the publish list: PublishDir is the
    build output folder, so the build has already copied them by the time publish runs.
    If any AI API is ever used, delete this target - a missing projection assembly fails
    at load time, not at build time.
  -->
  <Target Name="RemoveUnusedWindowsML" AfterTargets="Build;Publish">
    <ItemGroup>
      <_UnusedMl Include="$(OutDir)onnxruntime.dll" />
      <_UnusedMl Include="$(OutDir)DirectML.dll" />
      <_UnusedMl Include="$(OutDir)Microsoft.ML.OnnxRuntime.dll" />
      <_UnusedMl Include="$(OutDir)NPUDetect.dll" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.AI.*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.Internal.AI.*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.*Vision*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.*SemanticSearch*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.*ImageCreation*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.*ContentModeration*" />
      <_UnusedMl Include="$(OutDir)Microsoft.Windows.Workloads*" />
      <_UnusedMl Include="$(OutDir)workloads.*.json" />
      <_UnusedMl Include="$(OutDir)Microsoft.Graphics.*Imaging*" />
    </ItemGroup>
    <Delete Files="@(_UnusedMl)" ContinueOnError="true" />
  </Target>

</Project>