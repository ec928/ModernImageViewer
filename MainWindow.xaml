<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernImageViewer"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    x:Class="ModernImageViewer.MainWindow"
    Title="Modern Image Viewer">

    <Grid x:Name="RootGrid" Background="Transparent" IsTabStop="True" 
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop"
          PreviewKeyDown="RootGrid_PreviewKeyDown">

        <Grid x:Name="DragZone" Height="45" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Opacity="0" Canvas.ZIndex="1000">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.25"/>
            </Grid.OpacityTransition>
            <Rectangle Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4" IsHitTestVisible="False"/>
        </Grid>

        <Grid x:Name="HoverTriggerZone" Width="15" HorizontalAlignment="Left" Background="#01000000" PointerEntered="HoverZone_PointerEntered" Canvas.ZIndex="2000" />

        <SplitView x:Name="SidebarView" PanePlacement="Left" DisplayMode="Overlay" OpenPaneLength="360">
            <SplitView.Pane>
                <Grid x:Name="SidebarPane" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" PointerExited="Sidebar_PointerExited">
                    <Grid Padding="10,38,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- === BUTTON ROW (5 buttons) === -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Click="BrowseButton_Click" HorizontalAlignment="Stretch" Margin="3" ToolTipService.ToolTip="Browse Folders">
                                <SymbolIcon Symbol="Folder"/>
                            </Button>

                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Margin="3" ToolTipService.ToolTip="Recent Folders">
                                <SymbolIcon Symbol="Library"/>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="RecentFoldersMenu" Opening="RecentFoldersMenu_Opening" />
                                </Button.Flyout>
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Clear Recent Folders" Click="ClearRecentFolders_Click">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Delete"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                            </Button>

                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Margin="3" ToolTipService.ToolTip="Sort Images">
                                <SymbolIcon Symbol="Sort"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <RadioMenuFlyoutItem x:Name="SortNameAscItem" Text="Name (A-Z)" Click="Sort_Click" Tag="NameAsc" GroupName="SortGroup"/>
                                        <RadioMenuFlyoutItem x:Name="SortNameDescItem" Text="Name (Z-A)" Click="Sort_Click" Tag="NameDesc" GroupName="SortGroup"/>
                                        <MenuFlyoutSeparator/>
                                        <RadioMenuFlyoutItem x:Name="SortDateDescItem" Text="Date (Newest First)" Click="Sort_Click" Tag="DateDesc" GroupName="SortGroup"/>
                                        <RadioMenuFlyoutItem x:Name="SortDateAscItem" Text="Date (Oldest First)" Click="Sort_Click" Tag="DateAsc" GroupName="SortGroup"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="3" Click="PlayCinematicFolder_Click" HorizontalAlignment="Stretch" Margin="3" ToolTipService.ToolTip="Play Cinematic Slideshow">
                                <SymbolIcon Symbol="Play"/>
                            </Button>

                            <Button Grid.Column="4" Click="TestCollage_Click" HorizontalAlignment="Stretch" Margin="3" ToolTipService.ToolTip="Open Collage Editor">
                                <SymbolIcon Symbol="Pictures"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Click="OpenDirector_Click" HorizontalAlignment="Stretch" Margin="3" ToolTipService.ToolTip="Open Video Director">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Video"/>
                                    <TextBlock Text="Video Director"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Click="About_Click" Margin="3"
                                    AutomationProperties.Name="About"
                                    ToolTipService.ToolTip="About Modern Image Viewer">
                                <FontIcon Glyph="&#xE946;" FontSize="16"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2" Margin="5,0,5,15" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Grid.Column="0" Symbol="Pictures" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <Slider Grid.Column="1" x:Name="ThumbSizeSlider" Minimum="100" Maximum="400" Value="164" Width="190" VerticalAlignment="Center" ValueChanged="ThumbSizeSlider_ValueChanged" ToolTipService.ToolTip="Adjust Thumbnail Size"/>
                        </Grid>

                        <BreadcrumbBar x:Name="FolderBreadcrumb" Grid.Row="3" Margin="5,0,0,15" ItemClicked="BreadcrumbBar_ItemClicked"/>

                        <TreeView Grid.Row="4" x:Name="FolderTreeView" ItemInvoked="FolderTreeView_ItemInvoked" SelectionMode="Single" Margin="0,0,0,15">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,5" Background="Transparent" Opacity="{Binding Content.NodeOpacity}">
                                        <SymbolIcon Symbol="{Binding Content.NodeIcon}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Content.Name}" 
                               Style="{ThemeResource BodyTextBlockStyle}" 
                               TextTrimming="CharacterEllipsis" 
                               FontWeight="{Binding Content.NodeFontWeight}"/>

                                            <TextBlock Text="{Binding Content.Subtitle}" 
                               Visibility="{Binding Content.SubtitleVisibility}" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="TileHeader" Height="32">
                        <Grid.Resources>
                            <ControlTemplate x:Key="HeaderGlyph" TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition x:Name="CaptionInset" Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,2,0">
                            <Button Template="{StaticResource HeaderGlyph}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Click="RefreshFolder_Click" ToolTipService.ToolTip="Refresh Current Folder">
                                <FontIcon Glyph="&#xE117;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button Template="{StaticResource HeaderGlyph}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Click="ResetWindow_Click" ToolTipService.ToolTip="Reset Window Size">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Rectangle Width="1" Height="16" Margin="8,0" VerticalAlignment="Center" Fill="#99000000"/>
                            <Button Template="{StaticResource HeaderGlyph}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Sort">
                                <FontIcon Glyph="&#xE8CB;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="HeaderSortFlyout" Opening="HeaderSortFlyout_Opening">
                                        <RadioMenuFlyoutItem x:Name="HeaderSortNameAscItem" Text="Name (A-Z)" Click="Sort_Click" Tag="NameAsc" GroupName="HeaderSortGroup"/>
                                        <RadioMenuFlyoutItem x:Name="HeaderSortNameDescItem" Text="Name (Z-A)" Click="Sort_Click" Tag="NameDesc" GroupName="HeaderSortGroup"/>
                                        <MenuFlyoutSeparator/>
                                        <RadioMenuFlyoutItem x:Name="HeaderSortDateDescItem" Text="Date (Newest First)" Click="Sort_Click" Tag="DateDesc" GroupName="HeaderSortGroup"/>
                                        <RadioMenuFlyoutItem x:Name="HeaderSortDateAscItem" Text="Date (Oldest First)" Click="Sort_Click" Tag="DateAsc" GroupName="HeaderSortGroup"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="TileViewButton" Template="{StaticResource HeaderGlyph}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Click="ViewMode_Click" Tag="Tiles" ToolTipService.ToolTip="Tiles">
                                <FontIcon x:Name="TileViewIcon" Glyph="&#xE8A9;" FontSize="14"/>
                            </Button>
                            <Button x:Name="ListViewButton" Template="{StaticResource HeaderGlyph}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Click="ViewMode_Click" Tag="List" ToolTipService.ToolTip="List">
                                <FontIcon x:Name="ListViewIcon" Glyph="&#xE8FD;" FontSize="14" Opacity="0.35"/>
                            </Button>
                        </StackPanel>
                        <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.6" IsHitTestVisible="False"/>
                    </Grid>

                    <Grid Grid.Row="1">
                    <GridView x:Name="ImageGrid" Padding="10,8,10,0" SizeChanged="ImageGrid_SizeChanged" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended" SelectionChanged="ImageGrid_SelectionChanged" IsItemClickEnabled="True" ItemClick="ImageGrid_ItemClick" CanDragItems="True" DragItemsStarting="ImageGrid_DragItemsStarting" ItemsSource="{x:Bind Images, Mode=OneWay}" ContainerContentChanging="ImageGrid_ContainerContentChanging" FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0">
                        <GridView.Resources>
                            <Style x:Key="DenseListItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedPressedBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedDisabledBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedInnerBorderBrush" Color="Transparent"/>
                            <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
                        </GridView.Resources>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid x:Name="ImageWrapGrid" Orientation="Horizontal" CacheLength="10" ItemWidth="164" ItemHeight="164" Loaded="ImageWrapGrid_Loaded" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ImageItem">
                                <Grid>
                                    <Grid Visibility="{x:Bind TileVisibility, Mode=OneWay}" Margin="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed">
                                        <Grid.ScaleTransition>
                                            <Vector3Transition Duration="0:0:0.15" />
                                        </Grid.ScaleTransition>
                                        <Grid.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.15" />
                                        </Grid.OpacityTransition>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" x:Phase="2" Grid.Row="0" Stretch="UniformToFill" />
                                        <TextBlock Text="{x:Bind Name}"
                                                   x:Phase="1"
                                                   Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   Margin="4,4,4,6"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   FontSize="11"
                                                   ToolTipService.ToolTip="{x:Bind Name}"/>
                                        <Border Grid.Row="0" IsHitTestVisible="False" BorderThickness="3" CornerRadius="2"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="{x:Bind SelectionOpacity, Mode=OneWay}"/>
                                        <Grid Grid.Row="0" Width="18" Height="18" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              IsHitTestVisible="False" Opacity="{x:Bind SelectionOpacity, Mode=OneWay}">
                                            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="0" IsHitTestVisible="False" Opacity="{x:Bind KeyboardCursorOpacity, Mode=OneWay}">
                                            <Border Margin="4" CornerRadius="2" BorderThickness="1.5" BorderBrush="#F2FFFFFF"/>
                                            <Border Margin="5.5" CornerRadius="1" BorderThickness="1" BorderBrush="#59000000"/>
                                        </Grid>
                                    </Grid>
                                    <Grid Visibility="{x:Bind ListVisibility, Mode=OneWay}" Margin="6,0,4,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE91B;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border IsHitTestVisible="False" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind SelectionOpacity, Mode=OneWay}"/>
                                            <Grid Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="{x:Bind SelectionOpacity, Mode=OneWay}">
                                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="6" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" Margin="6,0,2,0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Margin="-2,0" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind KeyboardCursorOpacity, Mode=OneWay}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Canvas.ZIndex="500">
                        <ProgressRing x:Name="LoadingRing" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" />
                    </Grid>

                    <Grid x:Name="MultiSelectActionBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Canvas.ZIndex="500">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock x:Name="MultiSelectCountText" Text="0 selected" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,8,0" />

                                <Button Click="MultiSelectCinematic_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Play Cinematic">
                                    <SymbolIcon Symbol="Play" />
                                </Button>
                                <Button Click="MultiSelectCollage_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Add to Collage">
                                    <SymbolIcon Symbol="Pictures" />
                                </Button>
                                <Button Click="MultiSelectDelete_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete">
                                    <SymbolIcon Symbol="Delete" Foreground="Red" />
                                </Button>
                                <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" Opacity="0.4"/>
                                <Button Click="MultiSelectClear_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Clear Selection">
                                    <SymbolIcon Symbol="Cancel" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Grid>

                    <local:ImageViewerControl x:Name="ViewerControl"
                                              Grid.RowSpan="2"
                                              Visibility="Collapsed"
                                              Canvas.ZIndex="1000" 
                                              CloseRequested="ViewerControl_CloseRequested" 
                                              ToggleFullscreenRequested="ViewerControl_ToggleFullscreenRequested" 
                                              DetachRequested="ViewerControl_DetachRequested" 
                                              NavigateRequested="ViewerControl_NavigateRequested"
                                              TearOffInitiated="ViewerControl_TearOffInitiated"
                                              TearOffMoved="ViewerControl_TearOffMoved"
                                              TearOffCompleted="ViewerControl_TearOffCompleted"
                                              ShowInExplorerRequested="ViewerControl_ShowInExplorerRequested"
                                              DeviceLostRestoring="ViewerControl_DeviceLostRestoring"
                                              DetachLimitRequested="ViewerControl_DetachLimitRequested"
                                              EditRequested="ViewerControl_EditRequested"
                                              RenameRequested="ViewerControl_RenameRequested"
                                              DeleteRequested="ViewerControl_DeleteRequested"
                                              AddToCollageRequested="ViewerControl_AddToCollageRequested" />
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Window>