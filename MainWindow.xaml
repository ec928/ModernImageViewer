<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernImageViewer"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    x:Class="ModernImageViewer.MainWindow"
    Title="Modern Image Viewer">

    <Grid x:Name="RootGrid" Background="Transparent" IsTabStop="True" 
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop"
          PreviewKeyDown="RootGrid_PreviewKeyDown">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DragZone" Grid.RowSpan="2" Height="45" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Opacity="0" Canvas.ZIndex="1000">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.25"/>
            </Grid.OpacityTransition>
            <Rectangle Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4" IsHitTestVisible="False"/>
        </Grid>

                    <Grid x:Name="TileHeader" Height="36" Background="Transparent">
                        <Grid.Resources>
                            <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                <Setter Property="Width" Value="30"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition x:Name="CaptionInset" Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Style="{StaticResource HeaderButtonStyle}" Click="SidebarToggle_Click" ToolTipService.ToolTip="Navigation Sidebar (Ctrl+B or Tab)">
                                <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource HeaderButtonStyle}" Click="BrowseButton_Click" ToolTipService.ToolTip="Browse Folders">
                                <FontIcon x:Name="HeaderFolderIcon" Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Recent Folders">
                                <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="RecentFoldersMenu" Opening="RecentFoldersMenu_Opening" Closed="HeaderFlyout_Closed" />
                                </Button.Flyout>
                                <Button.ContextFlyout>
                                    <MenuFlyout Closed="HeaderFlyout_Closed">
                                        <MenuFlyoutItem Text="Clear Recent Folders" Click="ClearRecentFolders_Click">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Delete"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                            </Button>
                            <Rectangle Width="1" Height="16" Margin="4,0,2,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Button x:Name="HeaderFolderButton" Style="{StaticResource SubtleButtonStyle}" Height="28" MinWidth="0" MinHeight="0" Padding="8,0" CornerRadius="4" IsTabStop="False"
                                    Click="OpenCurrentDirectoryInExplorer_Click"
                                    PointerEntered="HeaderFolderButton_PointerEntered"
                                    PointerExited="HeaderFolderButton_PointerExited">
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout x:Name="HeaderPathFlyout" Placement="BottomEdgeAlignedLeft" ShowMode="TransientWithDismissOnPointerMoveAway" ShouldConstrainToRootBounds="False" Closed="HeaderFlyout_Closed">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="2"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                                <Setter Property="MaxWidth" Value="960"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="CornerRadius" Value="6"/>
                                                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <Button x:Name="HeaderPathFlyoutButton" Style="{StaticResource SubtleButtonStyle}" Padding="10,5" MinHeight="0" MinWidth="0" CornerRadius="4" IsTabStop="False"
                                                Click="OpenCurrentDirectoryInExplorer_Click"
                                                PointerEntered="HeaderPathFlyout_PointerEntered"
                                                PointerExited="HeaderPathFlyout_PointerExited">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock x:Name="HeaderPathFlyoutText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderFolderText" Text="Pictures" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="HeaderCountBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderCountText" Text="0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border x:Name="HeaderDragRegion" Grid.Column="1" Background="Transparent"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button Style="{StaticResource HeaderButtonStyle}" Click="RefreshFolder_Click" ToolTipService.ToolTip="Refresh Current Folder (F5)">
                                <FontIcon Glyph="&#xE72C;" FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="Sort Images">
                                <FontIcon Glyph="&#xE8CB;" FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="HeaderSortFlyout" Opening="HeaderSortFlyout_Opening" Closed="HeaderFlyout_Closed">
                                        <RadioMenuFlyoutItem x:Name="HeaderSortNameAscItem" Text="Name (A-Z)" Click="Sort_Click" Tag="NameAsc" GroupName="HeaderSortGroup"/>
                                        <RadioMenuFlyoutItem x:Name="HeaderSortNameDescItem" Text="Name (Z-A)" Click="Sort_Click" Tag="NameDesc" GroupName="HeaderSortGroup"/>
                                        <MenuFlyoutSeparator/>
                                        <RadioMenuFlyoutItem x:Name="HeaderSortDateDescItem" Text="Date (Newest First)" Click="Sort_Click" Tag="DateDesc" GroupName="HeaderSortGroup"/>
                                        <RadioMenuFlyoutItem x:Name="HeaderSortDateAscItem" Text="Date (Oldest First)" Click="Sort_Click" Tag="DateAsc" GroupName="HeaderSortGroup"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Rectangle Width="1" Height="16" Margin="6,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button x:Name="TilesModeButton" Style="{StaticResource HeaderButtonStyle}" Width="28" Height="22" CornerRadius="3" Click="TilesMode_Click" ToolTipService.ToolTip="Tile View">
                                        <FontIcon x:Name="TilesModeIcon" Glyph="&#xE8A9;" FontSize="13"/>
                                    </Button>
                                    <Button x:Name="ListModeButton" Style="{StaticResource HeaderButtonStyle}" Width="28" Height="22" CornerRadius="3" Click="ListMode_Click" ToolTipService.ToolTip="List View">
                                        <FontIcon x:Name="ListModeIcon" Glyph="&#xE8FD;" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Rectangle Width="1" Height="16" Margin="6,0,2,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Button Style="{StaticResource HeaderButtonStyle}" ToolTipService.ToolTip="View &amp; Window Options">
                                <FontIcon Glyph="&#xE713;" FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button.Flyout>
                                    <Flyout x:Name="HeaderSettingsFlyout" Placement="BottomEdgeAlignedRight" Opening="HeaderSettingsFlyout_Opening" Closed="HeaderFlyout_Closed">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="12,8"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="CornerRadius" Value="8"/>
                                                <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                                                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Tile Size" Width="56" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Slider x:Name="ThumbSizeSlider" Minimum="100" Maximum="400" Value="164" Width="136" VerticalAlignment="Center" IsTabStop="False" ValueChanged="ThumbSizeSlider_ValueChanged" ToolTipService.ToolTip="Adjust Tile Size"/>
                                                <Rectangle Width="1" Height="18" Margin="4,0,2,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                                <Button Style="{StaticResource HeaderButtonStyle}" Click="ResetWindow_Click" ToolTipService.ToolTip="Reset Window &amp; Tile Size">
                                                    <FontIcon Glyph="&#xE923;" FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Presets" Width="56" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="2" Width="136" VerticalAlignment="Center">
                                                    <Grid ColumnSpacing="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="Preset1Button" Grid.Column="0" Style="{StaticResource HeaderButtonStyle}" Width="42" Height="22" CornerRadius="3" Tag="0" Click="PresetSlot_Click" RightTapped="PresetSlot_RightTapped">
                                                            <Grid Width="36" Height="20">
                                                                <TextBlock x:Name="Preset1Text" Text="1" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Ellipse x:Name="Preset1Dot" Width="4" Height="4" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button x:Name="Preset2Button" Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Width="42" Height="22" CornerRadius="3" Tag="1" Click="PresetSlot_Click" RightTapped="PresetSlot_RightTapped">
                                                            <Grid Width="36" Height="20">
                                                                <TextBlock x:Name="Preset2Text" Text="2" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Ellipse x:Name="Preset2Dot" Width="4" Height="4" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button x:Name="Preset3Button" Grid.Column="2" Style="{StaticResource HeaderButtonStyle}" Width="42" Height="22" CornerRadius="3" Tag="2" Click="PresetSlot_Click" RightTapped="PresetSlot_RightTapped">
                                                            <Grid Width="36" Height="20">
                                                                <TextBlock x:Name="Preset3Text" Text="3" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Ellipse x:Name="Preset3Dot" Width="4" Height="4" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Rectangle Width="1" Height="18" Margin="4,0,2,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                                <Button x:Name="PresetSaveModeButton" Style="{StaticResource HeaderButtonStyle}" Click="PresetSaveMode_Click" ToolTipService.ToolTip="Save Current Window &amp; Tile Size to a Preset Slot">
                                                    <FontIcon x:Name="PresetSaveModeIcon" Glyph="&#xE74E;" FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Theme" Width="56" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="2" Width="136" VerticalAlignment="Center">
                                                    <Grid ColumnSpacing="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="ThemeLightButton" Grid.Column="0" Style="{StaticResource HeaderButtonStyle}" Width="64" Height="22" CornerRadius="3" Tag="Light" Click="ThemeMode_Click" ToolTipService.ToolTip="Light Theme">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <FontIcon x:Name="ThemeLightIcon" Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="11.5"/>
                                                                <TextBlock x:Name="ThemeLightText" Text="Light" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="ThemeDarkButton" Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Width="64" Height="22" CornerRadius="3" Tag="Dark" Click="ThemeMode_Click" ToolTipService.ToolTip="Dark Theme">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <FontIcon x:Name="ThemeDarkIcon" Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="11.5"/>
                                                                <TextBlock x:Name="ThemeDarkText" Text="Dark" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Rectangle Width="1" Height="18" Margin="4,0,2,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                                <Button x:Name="ThemeSystemButton" Style="{StaticResource HeaderButtonStyle}" Tag="System" Click="ThemeMode_Click" ToolTipService.ToolTip="Use Windows System Theme">
                                                    <FontIcon x:Name="ThemeSystemIcon" Glyph="&#xE770;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>
                                            <Button Style="{StaticResource SubtleButtonStyle}" Click="About_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="28" Padding="8,0" CornerRadius="4" IsTabStop="False" AutomationProperties.Name="About" ToolTipService.ToolTip="About Modern Image Viewer">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE946;" FontSize="13.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="About Modern Image Viewer" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Rectangle Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource CardStrokeColorDefaultBrush}" IsHitTestVisible="False"/>
                    </Grid>

        <Grid x:Name="HoverTriggerZone" Grid.Row="1" Width="15" HorizontalAlignment="Left" Background="#01000000" PointerEntered="HoverZone_PointerEntered" Canvas.ZIndex="2000" />

        <SplitView x:Name="SidebarView" Grid.Row="1" PanePlacement="Left" DisplayMode="Overlay" OpenPaneLength="320" PaneBackground="Transparent" PaneClosed="SidebarView_PaneClosed" PaneOpened="SidebarView_PaneOpened">
            <SplitView.Pane>
                <Grid x:Name="SidebarPane"
                      Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                      BorderThickness="0,1,1,1"
                      CornerRadius="0,10,10,0"
                      Margin="0,8,0,8"
                      PointerExited="Sidebar_PointerExited">
                    <Grid Padding="0,6,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- === SINGLE ACTION BAR (Slideshow, Collage, Video Director) === -->
                        <Grid Grid.Row="0" Margin="8,2,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="PlayCinematicFolder_Click" HorizontalAlignment="Stretch" Height="30" Padding="0" Margin="2" IsTabStop="False" ToolTipService.ToolTip="Play Cinematic Slideshow">
                                <SymbolIcon Symbol="Play"/>
                            </Button>

                            <Button Grid.Column="1" Click="TestCollage_Click" HorizontalAlignment="Stretch" Height="30" Padding="0" Margin="2" IsTabStop="False" ToolTipService.ToolTip="Open Collage Editor">
                                <SymbolIcon Symbol="Pictures"/>
                            </Button>

                            <Button Grid.Column="2" Click="OpenDirector_Click" HorizontalAlignment="Stretch" Height="30" Padding="6,0" Margin="2" IsTabStop="False" ToolTipService.ToolTip="Open Video Director">
                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <SymbolIcon Symbol="Video"/>
                                    <TextBlock Text="Video Director" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <BreadcrumbBar x:Name="FolderBreadcrumb" Grid.Row="1" Margin="10,3,6,4" ItemClicked="BreadcrumbBar_ItemClicked" IsTabStop="False">
                            <BreadcrumbBar.Resources>
                                <x:Double x:Key="BreadcrumbBarItemThemeFontSize">12.5</x:Double>
                                <x:Double x:Key="BreadcrumbBarChevronFontSize">9.5</x:Double>
                                <Thickness x:Key="BreadcrumbBarChevronPadding">2,0,2,0</Thickness>
                                <Style TargetType="BreadcrumbBarItem">
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Padding" Value="4,2,4,2"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="AllowFocusOnInteraction" Value="False"/>
                                </Style>
                            </BreadcrumbBar.Resources>
                            <BreadcrumbBar.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12.5" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </BreadcrumbBar.ItemTemplate>
                        </BreadcrumbBar>

                        <TreeView Grid.Row="2" x:Name="FolderTreeView" ItemInvoked="FolderTreeView_ItemInvoked" PreviewKeyDown="FolderTreeView_PreviewKeyDown" SelectionMode="None" Margin="-8,4,0,4">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="MinHeight" Value="28"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="28" Margin="-8,0,-6,0" Padding="3,0,2,0" CornerRadius="4" Background="Transparent" Opacity="{Binding Content.NodeOpacity}">
                                        <Border IsHitTestVisible="False" Margin="-5,0,-2,0" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="{Binding Content.CurrentHighlightVisibility}"/>
                                        <Border IsHitTestVisible="False" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{Binding Content.CurrentHighlightVisibility}"/>
                                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                                <Grid Visibility="{Binding Content.FolderIconVisibility}">
                                                <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="14.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Content.FolderIconVisibility}"/>

                                                </Grid>
                                                <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="1,0,0,0" Visibility="{Binding Content.UpIconVisibility}"/>
                                                <FontIcon Glyph="&#xE736;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource ComicIconBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Content.ComicIconVisibility}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Content.Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" FontWeight="{Binding Content.NodeFontWeight}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="MainContentGrid" Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <GridView x:Name="ImageGrid" IsTabStop="False" Padding="10,12,10,0" PreviewKeyDown="ImageGrid_PreviewKeyDown" SizeChanged="ImageGrid_SizeChanged" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended" SelectionChanged="ImageGrid_SelectionChanged" IsItemClickEnabled="True" ItemClick="ImageGrid_ItemClick" RightTapped="ImageGrid_RightTapped" CanDragItems="True" DragItemsStarting="ImageGrid_DragItemsStarting" DragItemsCompleted="ImageGrid_DragItemsCompleted" ItemsSource="{x:Bind Images, Mode=OneWay}" ContainerContentChanging="ImageGrid_ContainerContentChanging" FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                <Setter Property="FocusVisualPrimaryBrush" Value="Transparent"/>
                                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ContextFlyout>
                            <MenuFlyout x:Name="GridItemContextFlyout" Closed="HeaderFlyout_Closed">
                                <MenuFlyoutItem x:Name="GridMenuOpenItem" Text="Open" Click="GridMenuOpen_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="View"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="GridMenuMultiViewItem" Text="View Together (Enter)" Click="GridMenuMultiView_Click">
                                    <MenuFlyoutItem.Icon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE748;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="GridMenuSelectItem" Text="Select" Click="GridMenuSelect_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Accept"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="GridMenuDetachItem" Text="Detach in New Window" Click="GridMenuDetach_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="NewWindow"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="GridMenuPhotoSep1"/>
                                <MenuFlyoutItem x:Name="GridMenuCinematicItem" Text="Play Cinematic Slideshow" Click="GridMenuCinematic_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Play"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="GridMenuCollageItem" Text="Add to Collage" Click="GridMenuCollage_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Pictures"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="GridMenuPhotoSep2"/>
                                <MenuFlyoutItem x:Name="GridMenuEditItem" Text="Edit Image" Click="GridMenuEdit_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="GridMenuRenameItem" Text="Rename (F2)" Click="GridMenuRename_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Rename"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="GridMenuDeleteItem" Text="Delete (Del)" Click="GridMenuDelete_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Show in Explorer" Click="GridMenuExplorer_Click">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Folder"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </GridView.ContextFlyout>
                        <GridView.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedPressedBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedDisabledBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemSelectedInnerBorderBrush" Color="Transparent"/>
                            <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
                            <SolidColorBrush x:Key="GridViewItemFocusVisualPrimaryBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemFocusVisualSecondaryBrush" Color="Transparent"/>
                        </GridView.Resources>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid x:Name="ImageWrapGrid" Orientation="Horizontal" CacheLength="2" ItemWidth="164" ItemHeight="164" Loaded="ImageWrapGrid_Loaded" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ImageItem">
                                <Grid>
                                    <Grid Visibility="{x:Bind TileVisibility, Mode=OneWay}" Margin="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed">
                                        <Grid.ScaleTransition>
                                            <Vector3Transition Duration="0:0:0.15" />
                                        </Grid.ScaleTransition>
                                        <Grid.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.15" />
                                        </Grid.OpacityTransition>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="26"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="5,5,0,0">
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" x:Phase="2" Stretch="UniformToFill" />
                                        </Border>
                                        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="4" Background="#B8181818" BorderBrush="#40FFFFFF" BorderThickness="1" IsHitTestVisible="False" Visibility="{x:Bind ComicBadgeVisibility, Mode=OneTime}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE736;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FFF8D348" VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ComicBadgeText, Mode=OneTime}" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}"
                                                   x:Phase="1"
                                                   Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   Margin="8,0,8,1"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   FontSize="11.5"
                                                   ToolTipService.ToolTip="{x:Bind Name}"/>
                                        <Border Grid.Row="0" Margin="3" IsHitTestVisible="False" Background="Transparent" BorderThickness="2" CornerRadius="4"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="{x:Bind SelectionOpacity, Mode=OneWay}"/>
                                        <Grid Grid.RowSpan="2" IsHitTestVisible="False" Opacity="{x:Bind KeyboardCursorOpacity, Mode=OneWay}">
                                            <Border CornerRadius="6" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Border Margin="2" CornerRadius="4" BorderThickness="1.2" BorderBrush="#E6FFFFFF"/>
                                        </Grid>
                                        <Grid Grid.Row="0" Width="32" Height="32" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Background="Transparent" PointerPressed="TileCheck_PointerPressed" Tapped="TileCheck_Tapped" ToolTipService.ToolTip="Select (Space or Ctrl+Click)">
                                            <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="False" Opacity="{x:Bind HoverCheckOpacity, Mode=OneWay}">
                                                <Ellipse Fill="#78000000" Stroke="#E6FFFFFF" StrokeThickness="1.5"/>
                                                <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#D9FFFFFF"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="False" Opacity="{x:Bind SelectionOpacity, Mode=OneWay}">
                                                <Ellipse Stroke="White" StrokeThickness="2">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    <Grid Visibility="{x:Bind ListVisibility, Mode=OneWay}" Height="24" Margin="2,1" Padding="5,0,4,0" CornerRadius="4" VerticalAlignment="Center" Background="Transparent" PointerEntered="ListRow_PointerEntered" PointerExited="ListRow_PointerExited" PointerPressed="Card_PointerPressed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Margin="-5,0,-4,0" CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Opacity="{x:Bind ListHoverOpacity, Mode=OneWay}"/>
                                        <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Margin="-5,0,-4,0" CornerRadius="4"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="{x:Bind SelectionWashOpacity, Mode=OneWay}"/>
                                        <Border Grid.ColumnSpan="2" Width="3" Height="15" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Margin="-5,0,0,0"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="{x:Bind SelectionOpacity, Mode=OneWay}"/>
                                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="14.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind PhotoListIconVisibility, Mode=OneTime}"/>
                                            <FontIcon Glyph="&#xE736;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource ComicIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ComicListIconVisibility, Mode=OneTime}"/>
                                            <Grid Width="18" Height="18" Visibility="{x:Bind DirectoryListIconVisibility, Mode=OneTime}">
                                                <Grid Visibility="{x:Bind DirectoryFallbackVisibility, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE8D5;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FFF5B926" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#FF9A6300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ParentUpBadgeVisibility, Mode=OneWay}"/>
                                                <Image Source="{x:Bind DirectoryIcon, Mode=OneWay}" Stretch="Uniform"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" Margin="5,0,2,0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                        <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Margin="-5,0,-4,0" CornerRadius="4" BorderThickness="1.5" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind KeyboardCursorOpacity, Mode=OneWay}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <Grid x:Name="EmptyFolderOverlay" Grid.Row="0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.ZIndex="100">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyFolderTitle" Text="No photos in this folder" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button x:Name="EmptyFolderSubfoldersButton" Click="ListMode_Click" Visibility="Collapsed" Padding="12,6" CornerRadius="4">
                                    <TextBlock x:Name="EmptyFolderSubfoldersText" Text="View Subfolders in List Mode" FontSize="12"/>
                                </Button>
                                <Button Click="BrowseButton_Click" Padding="12,6" CornerRadius="4">
                                    <TextBlock Text="Browse Folders…" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Canvas.ZIndex="500">
                        <ProgressRing x:Name="LoadingRing" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" />
                    </Grid>

                    <Grid x:Name="MultiSelectActionBar" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Canvas.ZIndex="300">
                        <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" CornerRadius="22" Padding="18,6" Translation="0,0,32">
                            <Border.Shadow>
                                <ThemeShadow/>
                            </Border.Shadow>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="MultiSelectCountText" Text="0 selected" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,6,0" />

                                <Button Click="MultiSelectViewTogether_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,6" CornerRadius="6" ToolTipService.ToolTip="View Together (Enter)">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE748;" FontSize="16" />
                                </Button>
                                <Button Click="MultiSelectCinematic_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,6" CornerRadius="6" ToolTipService.ToolTip="Play Cinematic Slideshow">
                                    <SymbolIcon Symbol="Play" />
                                </Button>
                                <Button Click="MultiSelectCollage_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,6" CornerRadius="6" ToolTipService.ToolTip="Add to Collage">
                                    <SymbolIcon Symbol="Pictures" />
                                </Button>
                                <Button Click="MultiSelectDelete_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,6" CornerRadius="6" ToolTipService.ToolTip="Delete Selected (Del)">
                                    <SymbolIcon Symbol="Delete" Foreground="#FFD13438" />
                                </Button>
                                <Rectangle Width="1" Height="18" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0" Opacity="0.5"/>
                                <Button Click="MultiSelectClear_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,6" CornerRadius="6" ToolTipService.ToolTip="Clear Selection (Esc)">
                                    <SymbolIcon Symbol="Cancel" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ListPreviewBar" Grid.Row="1" Height="180" Visibility="Collapsed"
                          Background="Transparent"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="24,12,28,12" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                                <ColumnDefinition Width="Auto" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreviewNameText" Grid.ColumnSpan="2" Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <StackPanel Grid.Row="1" Spacing="3">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Type" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewTypeText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid x:Name="PreviewSizeRow" Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Size" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewSizeText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid x:Name="PreviewModifiedRow" Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Date modified" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewModifiedText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="PreviewPhotoRightColumn" Grid.Row="1" Grid.Column="1" Margin="24,0,0,0" Spacing="3">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dimensions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewDimensionsText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Date taken" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewTakenText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" Height="20" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Location" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="PreviewLocationButton" Grid.Column="1" Click="ShowInExplorer_Click" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" IsTabStop="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center">
                                    <TextBlock x:Name="PreviewLocationText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Button>
                            </Grid>
                        </Grid>
                        <Border Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="0,4,16,4"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Tapped="PreviewThumbnail_Tapped" ToolTipService.ToolTip="Click to open (Enter)">
                            <Grid>
                                <FontIcon x:Name="PreviewPlaceholder" FontFamily="Segoe Fluent Icons" Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <FontIcon x:Name="PreviewFolderIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" FontSize="64" Foreground="#FFF8D348" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="PreviewFolderImage" Stretch="Uniform" MaxWidth="120" MaxHeight="120" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>

                    <local:ImageViewerControl x:Name="ViewerControl"
                                              Grid.RowSpan="2"
                                              Visibility="Collapsed"
                                              Canvas.ZIndex="1000" 
                                              CloseRequested="ViewerControl_CloseRequested" 
                                              ToggleFullscreenRequested="ViewerControl_ToggleFullscreenRequested" 
                                              DetachRequested="ViewerControl_DetachRequested" 
                                              NavigateRequested="ViewerControl_NavigateRequested"
                                              TearOffInitiated="ViewerControl_TearOffInitiated"
                                              TearOffMoved="ViewerControl_TearOffMoved"
                                              TearOffCompleted="ViewerControl_TearOffCompleted"
                                              ShowInExplorerRequested="ViewerControl_ShowInExplorerRequested"
                                              DeviceLostRestoring="ViewerControl_DeviceLostRestoring"
                                              DetachLimitRequested="ViewerControl_DetachLimitRequested"
                                              EditRequested="ViewerControl_EditRequested"
                                              RenameRequested="ViewerControl_RenameRequested"
                                              DeleteRequested="ViewerControl_DeleteRequested"
                                              AddToCollageRequested="ViewerControl_AddToCollageRequested" />

                    <local:MultiViewControl x:Name="MultiViewControl"
                                            Grid.RowSpan="2"
                                            Visibility="Collapsed"
                                            Canvas.ZIndex="1000"
                                            CloseRequested="MultiViewControl_CloseRequested" />
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Window>
