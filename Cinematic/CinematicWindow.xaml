<Window
    x:Class="ModernImageViewer.Cinematic.CinematicWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:viewmodels="using:ModernImageViewer.Cinematic.ViewModels"
    Title="Cinematic Sequence">

    <Grid x:Name="RootGrid" Background="Black" PointerMoved="RootGrid_PointerMoved" KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">

        <!-- Native Zero-Friction Keyboard Controls -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="Accelerator_PlayPause" />
            <KeyboardAccelerator Key="Left" Invoked="Accelerator_Prev" />
            <KeyboardAccelerator Key="Right" Invoked="Accelerator_Next" />
            <KeyboardAccelerator Key="Escape" Invoked="Accelerator_Escape" />
        </Grid.KeyboardAccelerators>

        <ProgressBar x:Name="SlideProgressBar" VerticalAlignment="Top" HorizontalAlignment="Stretch" 
                     Minimum="0" Maximum="1" Value="0" Height="2" Background="Transparent"
                     Foreground="{ThemeResource SystemAccentColor}"
                     Opacity="{x:Bind ActionBar.Opacity, Mode=OneWay}" Canvas.ZIndex="1000" />

        <Grid x:Name="SequenceBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="16,0,16,92"
              Canvas.ZIndex="1000" Visibility="Collapsed" Opacity="{x:Bind ActionBar.Opacity, Mode=OneWay}"
              AllowDrop="True" DragOver="SequenceBar_DragOver" Drop="SequenceBar_Drop"
              PointerEntered="Chrome_PointerEntered" PointerExited="Chrome_PointerExited">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="108" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                <Button Content="New" Click="BtnSeqNew_Click"
                        ToolTipService.ToolTip="Reset the strip to the stills you opened this show with" />
                <Button Content="Load" Click="BtnLoad_Click" ToolTipService.ToolTip="Open a saved show (order, hide, custom zoom/pan)" />
                <Button Content="Save" Click="BtnExport_Click" ToolTipService.ToolTip="Save this show to a JSON file" />
                <Border Width="1" Height="18" Background="#55FFFFFF" Margin="6,0" />
                <Button Content="{x:Bind ViewModel.HideButtonLabel, Mode=OneWay}" Click="BtnSeqHide_Click"
                        ToolTipService.ToolTip="Hide: stay in the strip, skipped in play. Unhide to bring it back." />
                <Button Content="Remove" Click="BtnSeqRemove_Click"
                        ToolTipService.ToolTip="Take out of this show. File stays on disk. Add from folder or drop files to put it back." />
                <Button Content="Duplicate" Click="BtnSeqDuplicate_Click" ToolTipService.ToolTip="Insert a copy after this still" />
                <Button Content="Add from folder" Click="BtnSeqAddFromFolder_Click"
                        ToolTipService.ToolTip="Pick a folder and append stills that are not already in the strip" />
            </StackPanel>
            <ListView x:Name="SequenceStrip" Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Track, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.CurrentIndex, Mode=OneWay}"
                      SelectionMode="Single"
                      CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                      DragItemsCompleted="SequenceStrip_DragItemsCompleted"
                      SelectionChanged="SequenceStrip_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      Background="#99000000">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TrackClip">
                        <Grid Width="120" Height="96" Opacity="{x:Bind TileOpacity, Mode=OneWay}">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            <Border BorderBrush="#FF4CC2FF" BorderThickness="2" IsHitTestVisible="False"
                                    Opacity="{x:Bind ActiveBorderOpacity, Mode=OneWay}" />
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4" Padding="5,1"
                                    CornerRadius="3" Background="{x:Bind StatusBrush, Mode=OneWay}">
                                <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="10" Foreground="White" />
                            </Border>
                            <TextBlock Text="{x:Bind FileName, Mode=OneWay}" VerticalAlignment="Bottom" Margin="4"
                                       FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border x:Name="ActionBar" Canvas.ZIndex="1000" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" Padding="6,4" 
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" 
                BorderThickness="1" CornerRadius="26" RequestedTheme="Dark"
                Translation="0,0,32"
                PointerEntered="Chrome_PointerEntered" PointerExited="Chrome_PointerExited">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>

            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3"/>
            </Border.OpacityTransition>

            <StackPanel Orientation="Horizontal" Spacing="2">

                <!-- Playlist Controls -->
                <ToggleButton x:Name="BtnShuffle" IsTabStop="False" UseSystemFocusVisuals="False" IsChecked="{x:Bind ViewModel.IsShuffleEnabled, Mode=TwoWay}" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Toggle Shuffle">
                    <SymbolIcon Symbol="Shuffle" />
                </ToggleButton>
                <ToggleButton x:Name="BtnLoop" IsTabStop="False" UseSystemFocusVisuals="False" IsChecked="{x:Bind ViewModel.IsLoopEnabled, Mode=TwoWay}" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Toggle Loop">
                    <SymbolIcon Symbol="RepeatAll" />
                </ToggleButton>

                <Border Width="1" Height="24" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="4,0" />

                <!-- Playback Controls -->
                <Button x:Name="BtnBack" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnBack_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Previous Slide">
                    <SymbolIcon Symbol="Previous" />
                </Button>
                <Button x:Name="BtnPlayStop" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnPlayStop_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Play / Pause">
                    <SymbolIcon Symbol="{x:Bind ViewModel.PlayPauseIcon, Mode=OneWay}" />
                </Button>
                <Button x:Name="BtnForward" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnForward_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Next Slide">
                    <SymbolIcon Symbol="Next" />
                </Button>

                <Border Width="1" Height="24" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="4,0" />

                <ToggleButton x:Name="BtnSequenceToggle" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnSequenceToggle_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Track manager">
                    <SymbolIcon x:Name="IconSequence" Symbol="List" />
                </ToggleButton>
                <ToggleButton x:Name="BtnDirectorToggle" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnDirectorToggle_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Director (Ken Burns)">
                    <SymbolIcon x:Name="IconDirector" Symbol="Edit" />
                </ToggleButton>
            </StackPanel>
        </Border>

        <SplitView x:Name="DirectorSidebar" PanePlacement="Right" DisplayMode="Inline" OpenPaneLength="340" 
                   PaneOpening="DirectorSidebar_PaneOpening" PaneClosed="DirectorSidebar_PaneClosed">

            <SplitView.Pane>
                <Grid x:Name="DirectorPanelGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="24,40,24,24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Ken Burns" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.PanelHeader, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.85" />
                                    <TextBlock x:Name="ZoomPanReadout" FontSize="12" Opacity="0.7" />
                                </StackPanel>

                                <Button Content="Preview" Click="BtnPreview_Click" HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="Play this shot as it will appear" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Save" Click="BtnSaveZoomPan_Click" HorizontalAlignment="Stretch"
                                            IsEnabled="{x:Bind ViewModel.CanSaveZoomPan, Mode=OneWay}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="Save this slide's zoom/pan. Until then the show uses Auto or the last save." />
                                    <Button Content="Revert" Click="BtnClearTarget_Click" HorizontalAlignment="Stretch" Grid.Column="1"
                                            IsEnabled="{x:Bind ViewModel.CanRevertZoomPan, Mode=OneWay}"
                                            ToolTipService.ToolTip="Throw away draft and saved zoom/pan. Engine Auto again." />
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Curve" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <ComboBox HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.CurveOverride, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Ease in-out" Tag="EaseInOut" />
                                        <ComboBoxItem Content="Linear" Tag="Linear" />
                                        <ComboBoxItem Content="Ease in" Tag="EaseIn" />
                                        <ComboBoxItem Content="Ease out" Tag="EaseOut" />
                                        <ComboBoxItem Content="Snap zoom" Tag="SnapZoom" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Duration" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.DurationLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                    <Slider Minimum="3" Maximum="30" Value="{x:Bind ViewModel.DurationSeconds, Mode=TwoWay}"
                                            ToolTipService.ToolTip="How long this shot holds" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Global" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Engine defaults for Auto shots" FontSize="12" Opacity="0.7" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Technique" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <ComboBox HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.TechniqueOverride, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Auto (engine choice)" Tag="Auto" />
                                        <ComboBoxItem Content="Contextual Drift" Tag="ContextualDrift" />
                                        <ComboBoxItem Content="Ethereal Hold" Tag="EtherealHold" />
                                        <ComboBoxItem Content="Intimate Reveal" Tag="IntimateReveal" />
                                        <ComboBoxItem Content="Discovery Track" Tag="DiscoveryTrack" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Motion intensity" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.IntensityPercent, Mode=TwoWay}"
                                            ToolTipService.ToolTip="How aggressive Auto zoom and pan are" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Sequence beats" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <Slider Minimum="1" Maximum="5" TickFrequency="1" TickPlacement="Outside" SnapsTo="Ticks"
                                            Value="{x:Bind ViewModel.BeatCount, Mode=TwoWay}"
                                            ToolTipService.ToolTip="How many camera moves Auto chains on a slide" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Motion direction" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <ComboBox HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.DirectionOverride, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Auto (random)" Tag="0" />
                                        <ComboBoxItem Content="Zoom in" Tag="1" />
                                        <ComboBoxItem Content="Zoom out" Tag="2" />
                                        <ComboBoxItem Content="Pan only" Tag="3" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <Button Content="Undo last move" Click="BtnUndo_Click" HorizontalAlignment="Stretch"
                                    ToolTipService.ToolTip="Put the last zoom/pan rectangle back" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Load" Click="BtnLoad_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Import a Cinematic JSON project" />
                                <Button Content="Export" Click="BtnExport_Click" HorizontalAlignment="Stretch" Grid.Column="1" ToolTipService.ToolTip="Save the project to disk" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid>
                    <canvas:CanvasControl x:Name="SlideshowCanvas" CreateResources="SlideshowCanvas_CreateResources" Draw="SlideshowCanvas_Draw" SizeChanged="SlideshowCanvas_SizeChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <Border x:Name="WysiwygHint" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Border x:Name="TelemetryOverlay" Visibility="Collapsed" IsHitTestVisible="False" />

                    <Canvas x:Name="WysiwygOverlay" Visibility="Collapsed" Background="#01000000"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            SizeChanged="WysiwygOverlay_SizeChanged"
                            PointerPressed="WysiwygOverlay_PointerPressed"
                            PointerMoved="WysiwygOverlay_PointerMoved"
                            PointerReleased="WysiwygOverlay_PointerReleased"
                            PointerCanceled="WysiwygOverlay_PointerReleased"
                            PointerWheelChanged="WysiwygOverlay_PointerWheelChanged">

                        <Line x:Name="MotionPath" Stroke="#AAFFFFFF" StrokeThickness="2" IsHitTestVisible="False" />

                        <Border x:Name="StartFrameBox" Width="200" Height="112" Canvas.Left="0" Canvas.Top="0"
                                BorderBrush="#FF00D4FF" BorderThickness="4" Background="#1800D4FF"
                                Tag="start" IsHitTestVisible="False">
                            <Border Background="#EE003044" Padding="8,3" CornerRadius="3" Margin="6"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="Zoom/pan start" FontWeight="Bold" Foreground="#FF00D4FF" FontSize="12" />
                            </Border>
                        </Border>
                        <Border x:Name="EndFrameBox" Width="200" Height="112" Canvas.Left="0" Canvas.Top="0"
                                BorderBrush="#FFFF8A00" BorderThickness="2" Background="#18FF8A00"
                                Tag="end" IsHitTestVisible="False">
                            <Border Background="#EE402000" Padding="8,3" CornerRadius="3" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="Zoom/pan end" FontWeight="Bold" Foreground="#FFFF8A00" FontSize="12" />
                            </Border>
                        </Border>

                        <Rectangle x:Name="HandleTL" Width="16" Height="16" Fill="White" Stroke="#FF00D4FF" StrokeThickness="2" Tag="tl" PointerPressed="Handle_PointerPressed" />
                        <Rectangle x:Name="HandleTR" Width="16" Height="16" Fill="White" Stroke="#FF00D4FF" StrokeThickness="2" Tag="tr" PointerPressed="Handle_PointerPressed" />
                        <Rectangle x:Name="HandleBL" Width="16" Height="16" Fill="White" Stroke="#FF00D4FF" StrokeThickness="2" Tag="bl" PointerPressed="Handle_PointerPressed" />
                        <Rectangle x:Name="HandleBR" Width="16" Height="16" Fill="White" Stroke="#FF00D4FF" StrokeThickness="2" Tag="br" PointerPressed="Handle_PointerPressed" />
                    </Canvas>

                    <Border x:Name="StatusBanner" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="16,16,0,0" Background="#EE111111" Padding="14,10" CornerRadius="8"
                            IsHitTestVisible="False">
                        <StackPanel Spacing="4" MaxWidth="420">
                            <Border x:Name="StateBadge" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock x:Name="StateText" FontWeight="Bold" FontSize="16" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="StatusDetailText" FontSize="13" Foreground="#EEEEEE" TextWrapping="Wrap" />
                            <TextBlock x:Name="TelemetryText" FontFamily="Consolas" FontSize="12" Foreground="#BBBBBB" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="PreviewBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,16,0,0" Background="#EE8B0000" Padding="16,10" CornerRadius="8"
                            IsHitTestVisible="False">
                        <TextBlock Text="PREVIEWING THIS SHOT &#x2014; playback, not the still editor" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Window>