<Window
    x:Class="ModernImageViewer.Cinematic.CinematicWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:viewmodels="using:ModernImageViewer.Cinematic.ViewModels"
    Title="Cinematic Sequence">

    <Grid x:Name="RootGrid" Background="Black" PointerMoved="RootGrid_PointerMoved" KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">

        <!-- Native Zero-Friction Keyboard Controls -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="Accelerator_PlayPause" />
            <KeyboardAccelerator Key="Left" Invoked="Accelerator_Prev" />
            <KeyboardAccelerator Key="Right" Invoked="Accelerator_Next" />
            <KeyboardAccelerator Key="Escape" Invoked="Accelerator_Escape" />
            <KeyboardAccelerator Key="F11" Invoked="Accelerator_Fullscreen" />
        </Grid.KeyboardAccelerators>

        <ProgressBar x:Name="SlideProgressBar" VerticalAlignment="Top" HorizontalAlignment="Stretch" 
                     Minimum="0" Maximum="1" Value="0" Height="2" Background="Transparent"
                     Foreground="{ThemeResource SystemAccentColor}"
                     Opacity="{x:Bind ActionBar.Opacity, Mode=OneWay}" Canvas.ZIndex="1000" />

        <Grid x:Name="SequenceBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="16,0,356,92" RequestedTheme="Dark"
              Canvas.ZIndex="1000" Visibility="Collapsed" Opacity="{x:Bind ActionBar.Opacity, Mode=OneWay}"
              AllowDrop="True" DragOver="SequenceBar_DragOver" Drop="SequenceBar_Drop"
              PointerEntered="Chrome_PointerEntered" PointerExited="Chrome_PointerExited">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="108" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                <Button Content="{x:Bind ViewModel.HideButtonLabel, Mode=OneWay}" Click="BtnSeqHide_Click"
                        IsEnabled="{x:Bind ViewModel.CanHideOrRemove, Mode=OneWay}"
                        ToolTipService.ToolTip="Skipped in play and stays here to bring back. The file and your grid do not change." />
                <Button Content="Remove" Click="BtnSeqRemove_Click"
                        IsEnabled="{x:Bind ViewModel.CanHideOrRemove, Mode=OneWay}"
                        ToolTipService.ToolTip="Takes it out of this show. The file stays on disk." />
                <Button Content="Duplicate" Click="BtnSeqDuplicate_Click" ToolTipService.ToolTip="Adds a copy after this image" />
                <Button Content="Add images" Click="BtnSeqAddFromFolder_Click"
                        ToolTipService.ToolTip="Adds the images in a folder that are not already here. You can also drop files on this strip." />
                <Border Width="1" Height="18" Background="#55FFFFFF" Margin="6,0" />
                <Button Content="Start over" Click="BtnSeqNew_Click"
                        ToolTipService.ToolTip="Back to the images this show opened with, with no changes" />
            </StackPanel>
            <ListView x:Name="SequenceStrip" Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Track, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.CurrentIndex, Mode=OneWay}"
                      SelectionMode="Single"
                      CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                      DragItemsCompleted="SequenceStrip_DragItemsCompleted"
                      SelectionChanged="SequenceStrip_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      Background="#99000000">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TrackClip">
                        <Grid Width="120" Height="96" Opacity="{x:Bind TileOpacity, Mode=OneWay}">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            <Border BorderBrush="#FF4CC2FF" BorderThickness="2" IsHitTestVisible="False"
                                    Opacity="{x:Bind ActiveBorderOpacity, Mode=OneWay}" />
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4" Padding="5,1"
                                    CornerRadius="3" Background="{x:Bind StatusBrush, Mode=OneWay}">
                                <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="10" Foreground="White" />
                            </Border>
                            <TextBlock Text="{x:Bind FileName, Mode=OneWay}" VerticalAlignment="Bottom" Margin="4"
                                       FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border x:Name="ActionBar" Canvas.ZIndex="1000" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" Padding="6,4" 
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" 
                BorderThickness="1" CornerRadius="26" RequestedTheme="Dark"
                Translation="0,0,32"
                PointerEntered="Chrome_PointerEntered" PointerExited="Chrome_PointerExited">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>

            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3"/>
            </Border.OpacityTransition>

            <StackPanel Orientation="Horizontal" Spacing="2">

                <!-- Playlist Controls -->
                <ToggleButton x:Name="BtnShuffle" IsTabStop="False" UseSystemFocusVisuals="False" IsChecked="{x:Bind ViewModel.IsShuffleEnabled, Mode=TwoWay}" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Toggle Shuffle">
                    <SymbolIcon Symbol="Shuffle" />
                </ToggleButton>
                <ToggleButton x:Name="BtnLoop" IsTabStop="False" UseSystemFocusVisuals="False" IsChecked="{x:Bind ViewModel.IsLoopEnabled, Mode=TwoWay}" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Toggle Loop">
                    <SymbolIcon Symbol="RepeatAll" />
                </ToggleButton>

                <Border Width="1" Height="24" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="4,0" />

                <!-- Playback Controls -->
                <Button x:Name="BtnBack" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnBack_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Previous Slide">
                    <SymbolIcon Symbol="Previous" />
                </Button>
                <Button x:Name="BtnPlayStop" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnPlayStop_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Play / Pause">
                    <SymbolIcon Symbol="{x:Bind ViewModel.PlayPauseIcon, Mode=OneWay}" />
                </Button>
                <Button x:Name="BtnForward" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnForward_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Next Slide">
                    <SymbolIcon Symbol="Next" />
                </Button>

                <Border Width="1" Height="24" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="4,0" />

                <Button x:Name="BtnMusic" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnMusic_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MusicLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.MusicLabel, Mode=OneWay}">
                    <SymbolIcon Symbol="Audio" />
                </Button>
                <Button x:Name="BtnPreviousSong" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnPreviousSong_Click" Width="36" Height="44" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="18"
                        ToolTipService.ToolTip="Previous song" AutomationProperties.Name="Previous song" Visibility="{x:Bind ViewModel.NextSongVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button x:Name="BtnNextSong" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnNextSong_Click" Width="36" Height="44" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="18"
                        ToolTipService.ToolTip="Next song" AutomationProperties.Name="Next song" Visibility="{x:Bind ViewModel.NextSongVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <Slider x:Name="MusicVolumeSlider" Width="90" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="2,0,8,0"
                        IsTabStop="False" AllowFocusOnInteraction="False" AutomationProperties.Name="Music volume" ToolTipService.ToolTip="Music volume"
                        Value="{x:Bind ViewModel.MusicVolume, Mode=TwoWay}" Visibility="{x:Bind ViewModel.MusicVolumeVisibility, Mode=OneWay}" />

                <Border Width="1" Height="24" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="4,0" />

                <ToggleButton x:Name="BtnEditShow" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnEditShow_Click" Height="44" Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="22"
                              Content="Edit show" ToolTipService.ToolTip="Pauses the show and opens its images and this slide's settings" />

                <Border Width="1" Height="24" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="4,0" />

                <Button x:Name="BtnFullscreen" IsTabStop="False" UseSystemFocusVisuals="False" Click="BtnFullscreen_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="22" ToolTipService.ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen (F11)">
                    <SymbolIcon x:Name="IconFullscreen" Symbol="FullScreen" />
                </Button>
            </StackPanel>
        </Border>

        <canvas:CanvasControl x:Name="SlideshowCanvas" CreateResources="SlideshowCanvas_CreateResources" Draw="SlideshowCanvas_Draw" SizeChanged="SlideshowCanvas_SizeChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Canvas x:Name="WysiwygOverlay" Visibility="Collapsed" Background="#01000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                SizeChanged="WysiwygOverlay_SizeChanged"
                PointerPressed="WysiwygOverlay_PointerPressed"
                PointerMoved="WysiwygOverlay_PointerMoved"
                PointerReleased="WysiwygOverlay_PointerReleased"
                PointerCanceled="WysiwygOverlay_PointerReleased"
                PointerWheelChanged="WysiwygOverlay_PointerWheelChanged">

            <Line x:Name="MotionPath" Stroke="#AAFFFFFF" StrokeThickness="2" IsHitTestVisible="False" />

            <Border x:Name="StartFrameBox" Width="200" Height="112" Canvas.Left="0" Canvas.Top="0"
                    BorderBrush="#FF00D4FF" BorderThickness="4" Background="#1800D4FF"
                    Tag="start" IsHitTestVisible="False">
                <Border Background="#EE003044" Padding="8,3" CornerRadius="3" Margin="6"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="Start" FontWeight="Bold" Foreground="#FF00D4FF" FontSize="12" />
                </Border>
            </Border>
            <Border x:Name="EndFrameBox" Width="200" Height="112" Canvas.Left="0" Canvas.Top="0"
                    BorderBrush="#FFFF8A00" BorderThickness="2" Background="#18FF8A00"
                    Tag="end" IsHitTestVisible="False">
                <Border Background="#EE402000" Padding="8,3" CornerRadius="3" Margin="6"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="End" FontWeight="Bold" Foreground="#FFFF8A00" FontSize="12" />
                </Border>
            </Border>

            <Rectangle x:Name="HandleTL" Width="16" Height="16" Fill="White" Stroke="#FF00D4FF" StrokeThickness="2" Tag="tl" PointerPressed="Handle_PointerPressed" />
            <Rectangle x:Name="HandleTR" Width="16" Height="16" Fill="White" Stroke="#FF00D4FF" StrokeThickness="2" Tag="tr" PointerPressed="Handle_PointerPressed" />
            <Rectangle x:Name="HandleBL" Width="16" Height="16" Fill="White" Stroke="#FF00D4FF" StrokeThickness="2" Tag="bl" PointerPressed="Handle_PointerPressed" />
            <Rectangle x:Name="HandleBR" Width="16" Height="16" Fill="White" Stroke="#FF00D4FF" StrokeThickness="2" Tag="br" PointerPressed="Handle_PointerPressed" />
        </Canvas>

        <Border x:Name="PreviewBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,16,0,0" Background="#EE111111" Padding="16,10" CornerRadius="8"
                IsHitTestVisible="False">
            <TextBlock Text="Preview: how this slide will play. Esc goes back." FontWeight="SemiBold" Foreground="White" />
        </Border>

        <Grid x:Name="EditPanel" Visibility="Collapsed" Width="340" HorizontalAlignment="Right" Canvas.ZIndex="900" RequestedTheme="Dark"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="20,40,20,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock Text="This slide" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,2" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock x:Name="SlideBadgeText" Text="{x:Bind ViewModel.SlideBadge, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.CurrentFileName, Mode=OneWay}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock x:Name="FaceNote" FontSize="12" Opacity="0.85" />
                            <Grid x:Name="MoveStepper" Visibility="Collapsed" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MoveStepText" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           ToolTipService.ToolTip="Auto plays these moves one after the other. Saving your own boxes replaces them with one move." />
                                <Button x:Name="BtnPreviousMove" Grid.Column="1" Click="BtnPreviousMove_Click" AutomationProperties.Name="Previous move" ToolTipService.ToolTip="Previous move">
                                    <SymbolIcon Symbol="Back" />
                                </Button>
                                <Button x:Name="BtnNextMove" Grid.Column="2" Click="BtnNextMove_Click" AutomationProperties.Name="Next move" ToolTipService.ToolTip="Next move">
                                    <SymbolIcon Symbol="Forward" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Drag the Start and End boxes on the image to set where the camera goes." FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                            <Button Content="Preview" Click="BtnPreview_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Plays this slide as it will appear" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Save" Click="BtnSaveZoomPan_Click" HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.CanSaveZoomPan, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Keeps the boxes for this slide. Moving to another slide without saving drops them." />
                                <Button Content="Revert" Click="BtnClearTarget_Click" HorizontalAlignment="Stretch" Grid.Column="1"
                                        IsEnabled="{x:Bind ViewModel.CanRevertZoomPan, Mode=OneWay}"
                                        ToolTipService.ToolTip="Clears everything set for this slide, so it is Auto again" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Duration" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="DurationValueText" Text="{x:Bind ViewModel.DurationLabel, Mode=OneWay}" HorizontalAlignment="Right" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </Grid>
                                <Slider x:Name="SlideDurationSlider" Minimum="3" Maximum="30" Value="{x:Bind ViewModel.DurationSeconds, Mode=TwoWay}" AutomationProperties.Name="Duration of this slide"
                                        ToolTipService.ToolTip="How long this slide holds. Auto varies it from 5 to 20 seconds." />
                                <Button x:Name="BtnUseAutoDuration" Content="Use Auto" Click="BtnUseAutoDuration_Click" HorizontalAlignment="Right"
                                        IsEnabled="{x:Bind ViewModel.SlideDurationIsSet, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Move for this slide" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="SlideMoveBox" HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.SlideMove, Mode=TwoWay}" SelectedValuePath="Tag" AutomationProperties.Name="Move for this slide">
                                    <ComboBoxItem Content="Same as all slides" Tag="same" />
                                    <ComboBoxItem Content="Zoom in" Tag="1" />
                                    <ComboBoxItem Content="Zoom out" Tag="2" />
                                    <ComboBoxItem Content="Pan" Tag="3" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="All slides" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Move" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="AllMoveBox" HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.AllMove, Mode=TwoWay}" SelectedValuePath="Tag" AutomationProperties.Name="Move for all slides">
                                    <ComboBoxItem Content="Auto" Tag="0" />
                                    <ComboBoxItem Content="Zoom in" Tag="1" />
                                    <ComboBoxItem Content="Zoom out" Tag="2" />
                                    <ComboBoxItem Content="Pan" Tag="3" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Movement" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <Slider x:Name="MovementSlider" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Movement, Mode=TwoWay}" AutomationProperties.Name="Movement"
                                        ToolTipService.ToolTip="How far the camera travels on every Auto slide" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <Button Content="Undo last move" Click="BtnUndo_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Puts the last box move back" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Save show" Click="BtnExport_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Saves the images, order, framing and music to a file" />
                            <Button Content="Open show" Click="BtnLoad_Click" HorizontalAlignment="Stretch" Grid.Column="1" ToolTipService.ToolTip="Opens a saved show in this window" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>